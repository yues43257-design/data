def build_arg_parser() -> argparse.ArgumentParser:
    """CLI for the dataset-driven GNN training (and the legacy demo)."""
    parser = argparse.ArgumentParser(
        prog="Linux-MCX",
        description=(
            "PhaseGadgetGNN training on ZX datasets generated by data_generator.py "
            "(default: run the legacy CCX / C^4X routing demo)."
        ),
    )
    sub = parser.add_subparsers(dest="command")

    train = sub.add_parser(
        "train-gnn",
        aliases=["train"],
        help="train PhaseGadgetGNN on train.pt / val.pt with the joint loss",
    )
    train.add_argument("--data_dir", "--data-dir", dest="data_dir", default="full_dataset")
    train.add_argument("--epochs", type=int, default=60)
    train.add_argument("--batch_size", "--batch-size", dest="batch_size", type=int, default=64)
    train.add_argument("--lr", type=float, default=1e-3)
    train.add_argument("--weight_decay", "--weight-decay", dest="weight_decay", type=float, default=0.0)
    train.add_argument("--depth_weight", "--depth-weight", dest="depth_weight", type=float, default=0.5)
    train.add_argument("--parity_weight", "--parity-weight", dest="parity_weight", type=float, default=1.0)
    train.add_argument(
        "--parity_pos_weight", "--parity-pos-weight", dest="parity_pos_weight",
        type=float, default=1.0,
        help="positive-class weight of the parity BCE (parity bits are ~6%% positive; try 8-16)",
    )
    train.add_argument(
        "--parity_pos_weighting", "--parity-pos-weighting",
        dest="parity_pos_weighting", choices=("none", "bit_balanced"), default="none",
        help="'bit_balanced' = auto per-qubit neg/pos weights instead of the scalar",
    )
    train.add_argument(
        "--parity_pos_weight_clamp", "--parity-pos-weight-clamp",
        dest="parity_pos_weight_clamp", type=float, default=50.0,
        help="upper clamp for the per-qubit parity pos_weight",
    )
    train.add_argument("--phase_weight", "--phase-weight", dest="phase_weight", type=float, default=1.0)
    train.add_argument(
        "--pad_loss_weight", "--pad-loss-weight", dest="pad_loss_weight",
        type=float, default=0.0,
        help="weight of the padded (beyond y_seq_len) decoder steps; 0.0 = fully masked",
    )
    train.add_argument(
        "--phase_class_weighting", "--phase-class-weighting", dest="phase_class_weighting",
        choices=("none", "inv_freq"), default="none",
        help="inverse-frequency class weights for the 32-way phase CE",
    )
    train.add_argument(
        "--teacher_forcing_ratio", "--teacher-forcing-ratio",
        dest="teacher_forcing_ratio", type=float, default=1.0,
        help="1.0 = pure teacher forcing; <1 = scheduled sampling (closes train/inference gap)",
    )
    train.add_argument(
        "--stop_weight", "--stop-weight", dest="stop_weight", type=float, default=1.0,
        help="weight of the explicit end-of-sequence BCE",
    )
    train.add_argument(
        "--stop_pos_weight", "--stop-pos-weight", dest="stop_pos_weight",
        type=float, default=0.0,
        help="positive weight of the stop BCE; 0 = auto balance (#neg/#pos ~ 45)",
    )
    train.add_argument(
        "--count_weight", "--count-weight", dest="count_weight", type=float, default=0.1,
        help="weight of the sequence-length regression head",
    )
    train.add_argument(
        "--stop_threshold", "--stop-threshold", dest="stop_threshold", type=float, default=0.5,
        help="inference threshold on the stop logit",
    )
    train.add_argument(
        "--parity_reg_weight", "--parity-reg-weight", dest="parity_reg_weight",
        type=float, default=0.5,
        help="weight of the all-zero-row parity penalty relu(1 - sum_q p_q)",
    )
    train.add_argument(
        "--parity_reg_target", "--parity-reg-target", dest="parity_reg_target",
        default="auto",
        help="'auto' = require each row's target support, or a fixed expected 1-bit count",
    )
    train.add_argument(
        "--block_weight", "--block-weight", dest="block_weight", type=float, default=0.2,
        help="weight of the phase-block boundary BCE (0 disables it)",
    )
    train.add_argument(
        "--max_phase_terms", "--max-phase-terms", dest="max_phase_terms",
        type=int, default=MAX_PHASE_TERMS,
        help="candidate phase-term rows predicted per graph (default: MAX_PHASE_TERMS)",
    )
    train.add_argument("--hidden", type=int, default=GNN_HIDDEN)
    train.add_argument("--device", default="auto", help="auto | cpu | cuda | cuda:0 ...")
    train.add_argument(
        "--checkpoint", default="./checkpoints/best_gnn.pt",
        help="where the best validation checkpoint is written",
    )
    train.add_argument("--num_workers", "--num-workers", dest="num_workers", type=int, default=0)
    train.add_argument("--limit_train", "--limit-train", dest="limit_train", type=int, default=None)
    train.add_argument("--limit_val", "--limit-val", dest="limit_val", type=int, default=None)
    train.add_argument("--log_every", "--log-every", dest="log_every", type=int, default=1)
    train.add_argument("--seed", type=int, default=0)

    sub.add_parser("demo", help="run the original CCX / C^4X routing demo")
    return parser


def main(argv: "Optional[Sequence[str]]" = None) -> int:
    parser = build_arg_parser()
    args = parser.parse_args(argv)

    if args.command in (None, "demo"):
        run_legacy_demo()
        return 0

    if args.command in ("train", "train-gnn"):
        if not TORCH_GEO_AVAILABLE:
            print("PyTorch Geometric is not installed; cannot train.", file=sys.stderr)
            return 2
        cfg = GNNTrainingConfig(
            data_dir=args.data_dir,
            epochs=args.epochs,
            batch_size=args.batch_size,
            lr=args.lr,
            weight_decay=args.weight_decay,
            parity_weight=args.parity_weight,
            parity_pos_weight=args.parity_pos_weight,
            parity_pos_weighting=args.parity_pos_weighting,
            parity_pos_weight_clamp=args.parity_pos_weight_clamp,
            phase_weight=args.phase_weight,
            depth_weight=args.depth_weight,
            pad_loss_weight=args.pad_loss_weight,
            phase_class_weighting=args.phase_class_weighting,
            teacher_forcing_ratio=args.teacher_forcing_ratio,
            stop_weight=args.stop_weight,
            stop_pos_weight=args.stop_pos_weight,
            count_weight=args.count_weight,
            stop_threshold=args.stop_threshold,
            parity_reg_weight=args.parity_reg_weight,
            parity_reg_target=(
                args.parity_reg_target
                if str(args.parity_reg_target).lower() == "auto"
                else float(args.parity_reg_target)
            ),
            block_weight=getattr(args, "block_weight", 0.2),
            max_phase_terms=args.max_phase_terms,
            hidden=args.hidden,
            seed=args.seed,
            device=args.device,
            checkpoint_path=args.checkpoint,
            num_workers=args.num_workers,
            limit_train=args.limit_train,
            limit_val=args.limit_val,
            log_every=args.log_every,
        )
        train_phase_gadget_gnn_from_dataset(cfg)
        return 0

    parser.error(f"unknown command {args.command!r}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
