PHASE_EIGHTH = Fraction(1, 8)
RELATIVE_PHASE_LAMBDA = 10.0
MAX_QUBITS = 16
MAX_PHASE_TERMS = 64
GNN_HIDDEN = 32

# Discrete phase library.  k/16 * pi for k=0..31 covers I, Rz rotations,
# T(k=4), T-dagger(k=28), S/S-dagger and Z; the C^4X decomposition uses the
# k=1 and k=31 sixteenth-root rotations too.
PHASE_CLASSES = tuple(Fraction(k, 16) for k in range(32))
PHASE_CLASS_INDEX = {phase: k for k, phase in enumerate(PHASE_CLASSES)}
N_PHASE_CLASSES = len(PHASE_CLASSES)

# Strict FTQC T-gate definition: only +-pi/4 rotations count as T/T-dagger.
T_PHASES = (Fraction(1, 4), Fraction(7, 4))
T_DEPTH_LAMBDA = 1.0
T_COUNT_LAMBDA = 0.5


def _dump_qasm(qc: QuantumCircuit) -> str:
    if qasm2 is not None:
        return qasm2.dumps(qc)
    return qc.qasm()


def _is_non_clifford_phase(phase) -> bool:
    """ZX phase is a multiple of pi.  Clifford phases are multiples of pi/2."""
    p = Fraction(phase) % 2
    return (p * 2).denominator != 1


@dataclass(frozen=True)
class LocalPhaseGadget:
    """A sparse, graph-derived descriptor of one non-Clifford phase spider."""

    vertex: int
    phase: Fraction
    support: tuple[int, ...]
    degree: int
    neighbor_signature: tuple[tuple[str, str], ...]


def _gadget_support_qubits(g, start: int, max_depth: int = 5) -> tuple[int, ...]:
    """Return boundary qubits reachable from a spider without touching a matrix."""
    support: set[int] = set()
    seen = {start}
    frontier = [(start, 0)]
    while frontier:
        v, depth = frontier.pop()
        if depth >= max_depth:
            continue
        for w in g.neighbors(v):
            if w in seen:
                continue
            seen.add(w)
            if g.type(w) == zx.VertexType.BOUNDARY:
                q = g.qubit(w)
                if q >= 0:
                    support.add(q)
            else:
                frontier.append((w, depth + 1))
    if not support and g.qubit(start) >= 0:
        support.add(g.qubit(start))
    return tuple(sorted(support))


def extract_local_phase_gadgets(g) -> list[LocalPhaseGadget]:
    """Sparse graph scan; no dense matrix is ever materialized here."""
    features: list[LocalPhaseGadget] = []
    for v in g.vertices():
        if g.type(v) != zx.VertexType.Z:
            continue
        phase = Fraction(g.phase(v))
        if not _is_non_clifford_phase(phase):
            continue
        neighbors = list(g.neighbors(v))
        signature = tuple(
            sorted(
                (str(g.type(w)), str(Fraction(g.phase(w)))) for w in neighbors
            )
        )
        features.append(
            LocalPhaseGadget(
                vertex=v,
                phase=phase,
                support=_gadget_support_qubits(g, v),
                degree=len(neighbors),
                neighbor_signature=signature,
            )
        )
    return features


def make_source_circuit(relative_phase: bool) -> zx.Circuit:
    """
    Build the source circuit that we will route.

    ``relative_phase=False`` -> exact Qiskit/PyZX 7-T CCX.
    ``relative_phase=True``  -> Margolus/RCCX, exact only up to relative phases.
    """
    qc = QuantumCircuit(3)
    if relative_phase:
        # This is the standard 4-T relative-phase Toffoli (RCCX/Margolus),
        # NOT the old R_y version whose PyZX extraction inflated it to 6 Rz.
        qc.h(2)
        qc.t(2)
        qc.cx(1, 2)
        qc.tdg(2)
        qc.cx(0, 2)
        qc.t(2)
        qc.cx(1, 2)
        qc.tdg(2)
        qc.h(2)
    else:
        qc.ccx(0, 1, 2)
    circ = zx.Circuit.from_qasm(_dump_qasm(qc))
    return circ.to_basic_gates()


def make_mcx_source(num_controls: int) -> zx.Circuit:
    """
    Build an ancilla-free multi-controlled X gate in H/CNOT/Rz form.

    ``num_controls=4`` gives the requested C^4X on 5 qubits.  Qiskit's
    no-ancilla MCX synthesis is transpiled into the phase-polynomial-friendly
    gate set {H, CX, Rz} before we pass it to phase-polynomial routing.
    """
    n_qubits = num_controls + 1
    qc = QuantumCircuit(n_qubits)
    qc.append(MCXGate(num_controls), list(range(n_qubits)))
    qct = transpile(
        qc, basis_gates=["h", "cx", "rz"], optimization_level=1
    )
    return zx.Circuit.from_qasm(_dump_qasm(qct))


def _circuit_block(n_qubits: int, gates: Iterable) -> zx.Circuit:
    c = zx.Circuit(n_qubits)
    c.gates = list(gates)
    return c


def _phase_blocks(circuit: zx.Circuit) -> list[list]:
    """Split at Hadamard gates into CNOT+ZPhase phase-polynomial blocks."""
    blocks: list[list] = []
    current: list = []
    for gate in circuit.gates:
        if isinstance(gate, HAD):
            if current:
                blocks.append(current)
                current = []
        else:
            current.append(gate)
    if current:
        blocks.append(current)
    return blocks


def extract_phase_terms(circuit: zx.Circuit) -> dict[tuple[int, ...], Fraction]:
    """
    Track parities through CNOTs and collect Z phases (T/Tdg) per parity.

    This is the "phase polynomial" representation used by the Gray/Steiner
    phase-layer router.  The dictionary has one entry per non-Clifford
    rotation; no 2^N object is made.
    """
    n = circuit.qubits
    terms: dict[tuple[int, ...], Fraction] = {}
    for block in _phase_blocks(circuit):
        if not all(isinstance(g, (CNOT, ZPhase)) for g in block):
            continue
        pp = PhasePoly.fromCircuit(_circuit_block(n, block))
        for parity, phase in pp.zphases.items():
            key = tuple(int(parity[i]) for i in range(n))
            terms[key] = (terms.get(key, Fraction(0)) + Fraction(phase)) % 2
            if terms[key] == 0:
                del terms[key]
    return terms


def _term_to_bitstring(term: tuple[int, ...]) -> str:
    return "".join(str(int(b)) for b in term)


def _phase_class_name(phase: Fraction) -> str:
    p = Fraction(phase) % 2
    names = {
        Fraction(0): "I",
        Fraction(1, 4): "T",
        Fraction(7, 4): "T†",
        Fraction(1, 2): "S",
        Fraction(3, 2): "S†",
        Fraction(1): "Z",
    }
    if p in names:
        return names[p]
    k = round(float(p) * 16) % 32
    return f"Rz({k}/16)"


def print_phase_terms(title: str, terms: dict[tuple[int, ...], Fraction]) -> None:
    print(f"    [{title}] phase-polynomial terms:")
    for term in sorted(terms):
        p = terms[term] % 2
        print(
            f"        parity {_term_to_bitstring(term)} "
            f"-> phase {p}  (~{_phase_class_name(p)})"
        )


def gray_route_phase_layers(circuit: zx.Circuit) -> zx.Circuit:
    """
    Replace CNOT+T/CZ-free phase layers by phase-polynomial Gray routing.

    This is deliberately NOT ``pyzx.extract_circuit``: it consumes the phase
    polynomial directly and never re-extracts arbitrary ZX graph fragments.
    """
    n = circuit.qubits
    out = zx.Circuit(n)
    current: list = []

    def flush() -> None:
        nonlocal current
        if not current:
            return
        block = _circuit_block(n, current)
        if all(isinstance(g, (CNOT, ZPhase)) for g in current):
            try:
                pp = PhasePoly.fromCircuit(block)
                routed = route_phase_poly(
                    pp,
                    None,
                    method=RoutingMethod.GRAY,
                    mode=ElimMode.GAUSS_MODE,
                )
            except Exception:
                routed = block
        else:
            routed = block
        for g in routed.gates:
            out.add_gate(g)
        current = []

    for gate in circuit.gates:
        if isinstance(gate, HAD):
            flush()
            out.add_gate(gate)
        else:
            current.append(gate)
    flush()
    return out


def _count_cnots(circuit: zx.Circuit) -> int:
    return sum(1 for gate in circuit.gates if isinstance(gate, CNOT))


def _best_steiner_route(
    phase_poly: PhasePoly,
    block_seed: int,
    attempts: int = 6,
) -> zx.Circuit:
    """
    Randomized Steiner-tree phase-polynomial routing.

    For each phase layer we run several Steiner-mode Gray/Meijer attempts on a
    fully connected architecture and keep the candidate that minimizes the
    FTQC objective ``(T-depth, CX-count)``.
    This is the low-CNOT heuristic replacement for the single
    ``RoutingMethod.GRAY + GAUSS`` call.
    """
    n_qubits = phase_poly.out_par[0].n_qubits()
    architecture = create_architecture(FULLY_CONNECTED, n_qubits=n_qubits)
    best: zx.Circuit | None = None
    best_score: tuple[int, int] | None = None

    for method in (RoutingMethod.GRAY_MEIJER, RoutingMethod.MEIJER):
        for attempt in range(attempts):
            np.random.seed(20_260_909 + block_seed * 100 + attempt)
            try:
                candidate = route_phase_poly(
                    phase_poly,
                    architecture,
                    method=method,
                    mode=ElimMode.STEINER_MODE,
                    root_heuristic=RootHeuristic.RECURSIVE,
                    split_heuristic=SplitHeuristic.RANDOM,
                )
            except Exception:
                continue
            metrics = compute_ftq_metrics(candidate)
            score = (metrics.t_depth, _count_cnots(candidate))
            if best_score is None or score < best_score:
                best = candidate
                best_score = score

    if best is None:
        # Last-resort Meijer+Steiner fallback if the randomized attempts all
        # fail; the default extraction path never falls back to GRAY.
        best = route_phase_poly(
            phase_poly,
            architecture,
            method=RoutingMethod.MEIJER,
            mode=ElimMode.STEINER_MODE,
        )
    return best


def steiner_route_phase_layers(
    circuit: zx.Circuit, attempts: int = 6
) -> zx.Circuit:
    """
    Route CNOT+T/Rz phase layers with the low-CNOT Steiner heuristic.

    Hadamard boundaries are preserved; each maximal CNOT+ZPhase block is
    replaced by :func:`_best_steiner_route`.
    """
    n = circuit.qubits
    out = zx.Circuit(n)
    current: list = []
    block_id = 0

    def flush() -> None:
        nonlocal current, block_id
        if not current:
            return
        block = _circuit_block(n, current)
        if all(isinstance(g, (CNOT, ZPhase)) for g in current):
            try:
                pp = PhasePoly.fromCircuit(block)
                routed = _best_steiner_route(pp, block_id, attempts=attempts)
                block_id += 1
            except Exception:
                routed = block
        else:
            routed = block
        for g in routed.gates:
            out.add_gate(g)
        current = []

    for gate in circuit.gates:
        if isinstance(gate, HAD):
            flush()
            out.add_gate(gate)
        else:
            current.append(gate)
    flush()
    return out


def _qasm_gate_name(phase: Fraction) -> str:
    p = Fraction(phase) % 2
    if p == PHASE_EIGHTH * 2:      # +pi/4
        return "t"
    if p == Fraction(7, 4):        # -pi/4
        return "tdg"
    if p == Fraction(1, 2):
        return "s"
    if p == Fraction(3, 2):
        return "sdg"
    raise ValueError(f"non-T phase {phase} cannot be emitted as a T-count gate")


def circuit_to_t_qasm(circuit: zx.Circuit) -> str:
    """Custom QASM emitter: pi/4 Z-phases become literal T/Tdg gates."""
    lines = [
        "OPENQASM 2.0;",
        'include "qelib1.inc";',
        f"qreg q[{circuit.qubits}];",
    ]
    for gate in circuit.gates:
        if isinstance(gate, HAD):
            lines.append(f"h q[{gate.target}];")
        elif isinstance(gate, CNOT):
            lines.append(f"cx q[{gate.control}], q[{gate.target}];")
        elif isinstance(gate, ZPhase):
            lines.append(f"{_qasm_gate_name(Fraction(gate.phase))} q[{gate.target}];")
        else:
            raise TypeError(f"unexpected gate: {gate!r}")
    return "\n".join(lines) + "\n"


def count_t_gates(qasm: str) -> int:
    return sum(
        1
        for line in qasm.splitlines()
        if line.startswith("t q") or line.startswith("tdg q")
    )


@dataclass(frozen=True)
class FTQMetrics:
    """FTQC report: strict T-count, optimized T-depth, CX-depth."""

    t_count: int
    t_depth: int
    cx_depth: int


def _is_t_gate(gate) -> bool:
    return isinstance(gate, ZPhase) and (
        Fraction(gate.phase) % 2 in T_PHASES
    )


def _gate_qubits(gate) -> tuple[int, ...]:
    if isinstance(gate, CNOT):
        return (gate.control, gate.target)
    if isinstance(gate, (HAD, ZPhase)):
        return (gate.target,)
    return ()


def _layered_depth(circuit: zx.Circuit, counted) -> int:
    """
    Conservative dataflow depth for a subset of gates.

    Counted gates (T or CX depending on the caller) each consume one layer.
    Non-counted Clifford/phase gates carry data dependencies forward but do
    not themselves consume depth.  Gates on disjoint qubits are placed in the
    same layer, which is the basic "phase spiders can fire in parallel"
    scheduling rule used below.
    """
    last_depth = [0] * circuit.qubits
    total_depth = 0
    for gate in circuit.gates:
        qubits = _gate_qubits(gate)
        if not qubits:
            continue
        start = max(last_depth[q] for q in qubits)
        end = start + (1 if counted(gate) else 0)
        for q in qubits:
            last_depth[q] = end
        total_depth = max(total_depth, end)
    return total_depth


def _t_parallel_schedule(circuit: zx.Circuit) -> tuple[int, list[tuple[int, ZPhase]]]:
    """
    Assign each T/T-dagger gate to an earliest parallel layer.

    Only T gates consume layers; commuting gates on different qubits share a
    layer.  This layer assignment is the scheduler whose result is reported as
    T-depth and is later fed into the GNN objective.
    """
    last_depth = [0] * circuit.qubits
    layers: list[tuple[int, ZPhase]] = []
    for gate in circuit.gates:
        qubits = _gate_qubits(gate)
        if not qubits:
            continue
        start = max(last_depth[q] for q in qubits)
        if _is_t_gate(gate):
            start += 1
            layers.append((start, gate))
        for q in qubits:
            last_depth[q] = start
    return (max((layer for layer, _ in layers), default=0), layers)


def compute_ftq_metrics(circuit: zx.Circuit) -> FTQMetrics:
    """Return T-count, scheduled T-depth, and CX-depth."""
    t_count = sum(1 for g in circuit.gates if _is_t_gate(g))
    t_depth, _ = _t_parallel_schedule(circuit)
    cx_depth = _layered_depth(circuit, lambda g: isinstance(g, CNOT))
    return FTQMetrics(t_count=t_count, t_depth=t_depth, cx_depth=cx_depth)


def report_ftq_metrics(circuit: zx.Circuit, label: str) -> FTQMetrics:
    metrics = compute_ftq_metrics(circuit)
    print(
        f"    [{label}] T-count={metrics.t_count}, "
        f"T-depth={metrics.t_depth}, CX-depth={metrics.cx_depth}"
    )
    return metrics


def circuit_to_rz_qasm(circuit: zx.Circuit) -> str:
    """QASM emitter for arbitrary Rz phase layers (used by the C^4X flow)."""
    lines = [
        "OPENQASM 2.0;",
        'include "qelib1.inc";',
        f"qreg q[{circuit.qubits}];",
    ]
    for gate in circuit.gates:
        if isinstance(gate, HAD):
            lines.append(f"h q[{gate.target}];")
        elif isinstance(gate, CNOT):
            lines.append(f"cx q[{gate.control}], q[{gate.target}];")
        elif isinstance(gate, ZPhase):
            angle = float(Fraction(gate.phase))
            lines.append(f"rz({angle:.12g}*pi) q[{gate.target}];")
        else:
            raise TypeError(f"unexpected gate: {gate!r}")
    return "\n".join(lines) + "\n"


def report_cx_and_depth(circuit: zx.Circuit, label: str) -> tuple[int, int]:
    """Load a circuit's QASM into Qiskit and report CX count and depth."""
    qasm = circuit_to_rz_qasm(circuit)
    qc = QuantumCircuit.from_qasm_str(qasm)
    ops = qc.count_ops()
    cx = int(ops.get("cx", 0))
    depth = int(qc.depth())
    print(f"    [{label}] CX = {cx}, depth = {depth}")
    ftq = report_ftq_metrics(circuit, f"{label} FTQC")
    return cx, depth


def small_unitary_metrics(
    target: zx.Circuit, candidate: zx.Circuit
) -> tuple[float, float] | None:
    """
    Small-support verification of the loss term.

    This is only for the small support of the MCX phase gadget (2^k x 2^k
    with k=3).  It is not a CP/ALS decomposition and is not used to optimize a
    full global unitary.
    """
    if target.qubits != candidate.qubits or target.qubits > 8:
        return None  # exponential matrix deliberately disabled
    ut = np.asarray(target.to_matrix(), dtype=complex)
    uc = np.asarray(candidate.to_matrix(), dtype=complex)
    d = ut.conj().T @ uc
    dim = d.shape[0]

    # Coherent error: non-diagonal residual after U_target^dagger U_candidate.
    coherent = float(
        np.linalg.norm(d - np.diag(np.diag(d)), ord="fro") / np.sqrt(dim)
    )

    # Relative phase penalty, made invariant to an irrelevant global phase.
    diagonal = np.diag(d)
    ref_angles = np.unique(np.round(np.angle(diagonal), decimals=10))
    best = float("inf")
    for ref in ref_angles:
        aligned = diagonal * np.exp(-1j * ref)
        penalty = np.sqrt(np.mean(np.abs(aligned - 1.0) ** 2))
        best = min(best, float(penalty))
    return best, coherent


def phase_term_mismatches(
    exact: dict[tuple[int, ...], Fraction],
    proposal: dict[tuple[int, ...], Fraction],
) -> int:
    keys = set(exact) | set(proposal)
    return sum(
        1
        for key in keys
        if (exact.get(key, Fraction(0)) % 2)
        != (proposal.get(key, Fraction(0)) % 2)
    )


def zx_graph_to_pyg_data(g) -> Data:
    """Convert a simplified ZX graph to a PyG ``Data`` with node/edge features."""
    if not TORCH_GEO_AVAILABLE:
        raise RuntimeError("PyTorch Geometric is not installed")

    vertices = list(g.vertices())
    vertex_index = {v: i for i, v in enumerate(vertices)}
    node_feats: list[list[float]] = []

    for v in vertices:
        typ = g.type(v)
        type_feat = [0.0, 0.0, 0.0]
        if typ == zx.VertexType.BOUNDARY:
            type_feat[0] = 1.0
        elif typ == zx.VertexType.Z:
            type_feat[1] = 1.0
        else:
            type_feat[2] = 1.0

        phase_pi = float(Fraction(g.phase(v))) * math.pi
        degree = len(list(g.neighbors(v)))
        qubit = g.qubit(v)
        qubit_feat = [0.0] * MAX_QUBITS
        if 0 <= qubit < MAX_QUBITS:
            qubit_feat[qubit] = 1.0

        phase = Fraction(g.phase(v))
        noncliff = (
            1.0 if _is_non_clifford_phase(phase) else 0.0
        )
        node_feats.append(
            type_feat
            + [math.cos(phase_pi), math.sin(phase_pi)]
            + [math.log1p(degree)]
            + qubit_feat
            + [noncliff]
        )

    edge_list: list[list[int]] = []
    edge_feats: list[list[float]] = []
    for edge in g.edges():
        u, v = edge[0], edge[1]
        edge_feat = (
            [1.0, 0.0]
            if g.edge_type(edge) == zx.EdgeType.SIMPLE
            else [0.0, 1.0]
        )
        for a, b in ((vertex_index[u], vertex_index[v]),
                     (vertex_index[v], vertex_index[u])):
            edge_list.append([a, b])
            edge_feats.append(edge_feat)

    return Data(
        x=torch.tensor(node_feats, dtype=torch.float),
        edge_index=torch.tensor(edge_list, dtype=torch.long).t().contiguous(),
        edge_attr=torch.tensor(edge_feats, dtype=torch.float),
    )


class PhaseGadgetGNN(nn.Module):
    """
    Small trainable GNN used as a stand-in for AlphaTensor's rank proposal.

    Node/edge features come from the simplified ZX graph.  The graph-level
    readout predicts:
      * parity bits per candidate phase term (binary logits), and
      * one discrete phase class per candidate term (softmax over the
        :data:`PHASE_CLASSES` library).

    ``node_dim`` and ``max_phase_terms`` default to the original hard-coded
    values (sparse-graph features, ``MAX_PHASE_TERMS`` candidate rows) so the
    legacy fixtures keep working; the dataset training pipeline passes the
    feature width of the generated dataset explicitly.
    """

    def __init__(
        self,
        node_dim: Optional[int] = None,
        max_phase_terms: int = MAX_PHASE_TERMS,
        hidden: int = GNN_HIDDEN,
        max_qubits: int = MAX_QUBITS,
    ):
        super().__init__()
        if node_dim is None:
            node_dim = 7 + MAX_QUBITS
        self.node_dim = int(node_dim)
        self.max_phase_terms = int(max_phase_terms)
        self.max_qubits = int(max_qubits)
        self.hidden = int(hidden)
        self.conv1 = GINEConv(
            nn.Sequential(
                nn.Linear(self.node_dim, self.hidden),
                nn.ReLU(),
                nn.Linear(self.hidden, self.hidden),
            ),
            edge_dim=2,
        )
        self.conv2 = GCNConv(self.hidden, self.hidden)
        self.depth_head = nn.Sequential(
            nn.Linear(self.hidden, self.hidden),
            nn.ReLU(),
            nn.Linear(self.hidden, 1),
        )
        self.param_head = nn.Sequential(
            nn.Linear(self.hidden, self.hidden),
            nn.ReLU(),
            nn.Linear(
                self.hidden,
                self.max_phase_terms * (self.max_qubits + N_PHASE_CLASSES),
            ),
        )

    def forward(
        self, data: Data
    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
        h = F.relu(self.conv1(data.x, data.edge_index, data.edge_attr))
        h = F.relu(self.conv2(h, data.edge_index))
        batch = getattr(data, "batch", None)
        if batch is None:
            batch = torch.zeros(h.size(0), dtype=torch.long)
        pooled = global_mean_pool(h, batch)
        logits = self.param_head(pooled).view(
            -1, self.max_phase_terms, self.max_qubits + N_PHASE_CLASSES
        )
        parity_logits = logits[..., : self.max_qubits]
        phase_logits = logits[..., self.max_qubits :]
        depth = F.softplus(self.depth_head(pooled)).squeeze(-1)
        return parity_logits, phase_logits, depth


def _phase_terms_to_label(
    terms: dict[tuple[int, ...], Fraction], n_qubits: int
) -> tuple[torch.Tensor, torch.Tensor]:
    """
    One-hot labels for parity and discrete phase class.

    Inactive padded rows use the identity class (index 0) and zero parity.
    """
    parity = np.zeros((MAX_PHASE_TERMS, MAX_QUBITS), dtype=np.float32)
    onehot = np.zeros(
        (MAX_PHASE_TERMS, N_PHASE_CLASSES), dtype=np.float32
    )
    for row, (term, phase) in enumerate(sorted(terms.items())[:MAX_PHASE_TERMS]):
        for q in range(min(n_qubits, MAX_QUBITS)):
            parity[row, q] = int(term[q])
        cls = PHASE_CLASS_INDEX[Fraction(phase) % 2]
        onehot[row, cls] = 1.0
    return torch.from_numpy(parity), torch.from_numpy(onehot)


def _make_gnn_training_examples() -> list[Data]:
    examples: list[Data] = []
    fixtures = [
        ("ccx_strict", False, None),
        ("ccx_relative", True, None),
        ("c4x", False, 4),
    ]
    for _, relative, controls in fixtures:
        if controls is None:
            source = make_source_circuit(relative_phase=relative)
        else:
            source = make_mcx_source(controls)
        g = source.to_graph()
        zx.simplify.clifford_simp(g)
        terms = extract_phase_terms(source)
        data = zx_graph_to_pyg_data(g)
        data.y_parity, data.y_phase = _phase_terms_to_label(
            terms, source.qubits
        )
        data.y_count = float(len(terms))
        # Feedback: route the reference decomposition with the same Steiner
        # backend used downstream, then keep its scheduled T-depth as target.
        routed_ref = steiner_route_phase_layers(source)
        data.y_depth = float(compute_ftq_metrics(routed_ref).t_depth)
        examples.append(data)
    return examples


def train_phase_gadget_gnn(epochs: int = 600) -> PhaseGadgetGNN:
    """
    Train phase classification with cross-entropy; T-count/T-depth enter as
    non-phase auxiliary objectives (no continuous phase regression).

    Parity rows use binary cross-entropy; each phase row is a one-hot class
    over the discrete sixteenth-root phase library.
    """
    if not TORCH_GEO_AVAILABLE:
        raise RuntimeError("PyTorch Geometric is not installed")

    torch.manual_seed(0)
    examples = _make_gnn_training_examples()
    batch = Batch.from_data_list(examples)
    y_parity = torch.stack([d.y_parity for d in examples])
    y_phase = torch.stack([d.y_phase for d in examples])
    y_count = torch.tensor([d.y_count for d in examples], dtype=torch.float)
    y_depth = torch.tensor([d.y_depth for d in examples], dtype=torch.float)
    phase_targets = y_phase.argmax(dim=-1).reshape(-1)

    model = PhaseGadgetGNN()
    optimizer = torch.optim.Adam(model.parameters(), lr=0.01)

    for epoch in range(1, epochs + 1):
        model.train()
        optimizer.zero_grad()
        pred_parity, pred_phase, pred_depth = model(batch)
        parity_loss = F.binary_cross_entropy_with_logits(
            pred_parity, y_parity
        )
        phase_loss = F.cross_entropy(
            pred_phase.reshape(-1, N_PHASE_CLASSES),
            phase_targets,
        )
        # Differentiable surrogate for the achieved T-count: sum of
        # non-identity class probabilities.
        active_count = (
            1.0 - F.softmax(pred_phase, dim=-1)[..., 0]
        ).sum(dim=-1)
        count_loss = T_COUNT_LAMBDA * F.mse_loss(active_count, y_count)
        depth_loss = T_DEPTH_LAMBDA * F.smooth_l1_loss(
            pred_depth, y_depth
        )
        loss = parity_loss + phase_loss + count_loss + depth_loss
        loss.backward()
        optimizer.step()
        if epoch == 1 or epoch % 50 == 0:
            print(
                f"    [GNN train] epoch={epoch:3d} loss={loss.item():.4f} "
                f"phase_CE={phase_loss.item():.4f} "
                f"parity_BCE={parity_loss.item():.4f} "
                f"count={count_loss.item():.4f} depth={depth_loss.item():.4f}"
            )
    return model


_TRAINED_GNN: "PhaseGadgetGNN | None" = None


def get_trained_gnn(epochs: int = 600) -> PhaseGadgetGNN:
    global _TRAINED_GNN
    if _TRAINED_GNN is None:
        _TRAINED_GNN = train_phase_gadget_gnn(epochs=epochs)
    return _TRAINED_GNN


# ===========================================================================
# Dataset-driven PhaseGadgetGNN training
#
# Consumes the ``train.pt`` / ``val.pt`` files written by ``data_generator.py``
# (node features ``x`` + ``x_support``, per-term ``y_parity`` / ``y_phase``
# labels in the 32-class pi/16 grid, plus ``y_depth``) and trains the graph net
# with the joint objective
#
#     total = parity_weight * BCEWithLogits
#           + phase_weight  * CrossEntropy(32 classes)
#           + depth_weight  * SmoothL1
# ===========================================================================


@dataclass
class GNNTrainingConfig:
    """Configuration for :func:`train_phase_gadget_gnn_from_dataset`."""

    data_dir: str = "full_dataset"
    train_file: str = "train.pt"
    val_file: str = "val.pt"
    epochs: int = 60
    batch_size: int = 64
    lr: float = 1e-3
    weight_decay: float = 0.0
    parity_weight: float = 1.0
    parity_pos_weight: float = 1.0
    phase_weight: float = 1.0
    depth_weight: float = 0.5
    max_phase_terms: int = MAX_PHASE_TERMS
    hidden: int = GNN_HIDDEN
    seed: int = 0
    device: str = "auto"
    checkpoint_path: str = "./checkpoints/best_gnn.pt"
    num_workers: int = 0
    limit_train: Optional[int] = None
    limit_val: Optional[int] = None
    log_every: int = 1


def _resolve_device(spec: str) -> "torch.device":
    if spec == "auto":
        return torch.device("cuda" if torch.cuda.is_available() else "cpu")
    return torch.device(spec)


def _phase_class_magnitude(cls: int) -> int:
    """|phase| of a 32-class label in units of pi/16: 0 (identity) .. 16."""
    cls = int(cls) % N_PHASE_CLASSES
    return min(cls, N_PHASE_CLASSES - cls)


def _generator_node_features(
    sample: Data, max_qubits: int = MAX_QUBITS
) -> "torch.Tensor":
    """Generator node features plus a fixed-width per-qubit support mask."""
    x = sample.x.float()
    support = torch.zeros((x.size(0), max_qubits), dtype=torch.float)
    raw_support = getattr(sample, "x_support", None)
    if raw_support is not None and raw_support.numel():
        width = min(max_qubits, int(raw_support.size(1)))
        support[:, :width] = raw_support[:, :width].float()
    return torch.cat([x, support], dim=1)


def _generator_edge_attr(sample: Data) -> "torch.Tensor":
    """One-hot edge features: column 0 = simple (CNOT-like), 1 = Hadamard."""
    etype = getattr(sample, "edge_type", None)
    n_edges = int(sample.edge_index.size(1))
    if etype is None or etype.numel() != n_edges:
        return torch.zeros((n_edges, 2), dtype=torch.float)
    return F.one_hot(etype.long().clamp(0, 1), num_classes=2).float()


def _term_targets(
    sample: Data, max_terms: int, max_qubits: int = MAX_QUBITS
) -> "tuple[torch.Tensor, torch.Tensor]":
    """Build ``(1, max_terms, max_qubits)`` parity and ``(1, max_terms)`` phase targets.

    Rows are ordered by descending phase magnitude (the dominant terms survive
    truncation) and padded with zero parity / identity class 0, matching the
    padded-row convention used by :func:`_phase_terms_to_label`.
    """
    parity = torch.zeros((1, max_terms, max_qubits), dtype=torch.float)
    phase_idx = torch.zeros((1, max_terms), dtype=torch.long)
    rows_parity = sample.y_parity
    rows_phase = sample.y_phase
    if rows_parity is None or rows_parity.numel() == 0:
        return parity, phase_idx
    n_rows = int(rows_parity.size(0))
    order = sorted(
        range(n_rows),
        key=lambda row: (-_phase_class_magnitude(int(rows_phase[row])), row),
    )[:max_terms]
    width = min(max_qubits, int(rows_parity.size(1)))
    for slot, row in enumerate(order):
        parity[0, slot, :width] = rows_parity[row, :width].float()
        phase_idx[0, slot] = int(rows_phase[row]) % N_PHASE_CLASSES
    return parity, phase_idx


def adapt_generator_sample(
    sample: Data, cfg: "GNNTrainingConfig" = GNNTrainingConfig()
) -> Data:
    """Convert one ``data_generator.py`` sample into a PhaseGadgetGNN input."""
    x = _generator_node_features(sample)
    data = Data(
        x=x,
        edge_index=sample.edge_index.long(),
        edge_attr=_generator_edge_attr(sample),
    )
    parity, phase_idx = _term_targets(sample, cfg.max_phase_terms)
    data.y_parity = parity          # (1, T, Q) float -> batches to (B, T, Q)
    data.y_phase_idx = phase_idx    # (1, T) long   -> batches to (B, T)
    depth = getattr(sample, "y_depth", None)
    if depth is None:
        depth = (sample.metadata or {}).get("t_depth", 0.0)
    data.y_depth = torch.as_tensor(depth, dtype=torch.float).reshape(1)
    # keep a few provenance scalars; the raw dict also carries the QASM string,
    # which would be shipped through every batch for no benefit
    raw_meta = getattr(sample, "metadata", None) or {}
    data.metadata = {
        key: raw_meta.get(key)
        for key in ("family", "n_qubits", "optimality_level", "split", "t_depth")
    }
    data.n_terms_raw = int(sample.y_phase.numel())
    return data


def load_generator_split(
    path: str,
    cfg: "GNNTrainingConfig" = GNNTrainingConfig(),
    limit: Optional[int] = None,
) -> "list[Data]":
    """Load one ``*.pt`` split written by ``data_generator.py``."""
    if not TORCH_GEO_AVAILABLE:
        raise RuntimeError("PyTorch Geometric is not installed")
    raw = torch.load(path, weights_only=False)
    if limit is not None and limit > 0:
        raw = raw[:limit]
    return [adapt_generator_sample(sample, cfg) for sample in raw]


def _joint_losses(
    model: "PhaseGadgetGNN",
    batch: Data,
    cfg: "GNNTrainingConfig",
) -> "tuple[torch.Tensor, dict[str, torch.Tensor]]":
    """Joint parity / phase / depth objective for one batch."""
    parity_logits, phase_logits, depth_pred = model(batch)
    y_parity = batch.y_parity.float()
    y_phase = batch.y_phase_idx.long()
    y_depth = batch.y_depth.float().reshape(-1)

    # parity bits are sparse (~6% positives on the generated data); the
    # optional positive-class weight keeps the BCE from collapsing onto "all
    # zeros" (default 1.0 = plain BCEWithLogitsLoss).
    pos_weight = torch.as_tensor(
        float(cfg.parity_pos_weight),
        dtype=parity_logits.dtype,
        device=parity_logits.device,
    )
    parity_loss = F.binary_cross_entropy_with_logits(
        parity_logits, y_parity, pos_weight=pos_weight
    )
    phase_loss = F.cross_entropy(
        phase_logits.reshape(-1, N_PHASE_CLASSES), y_phase.reshape(-1)
    )
    depth_loss = F.smooth_l1_loss(depth_pred.reshape(-1), y_depth)
    total = (
        cfg.parity_weight * parity_loss
        + cfg.phase_weight * phase_loss
        + cfg.depth_weight * depth_loss
    )
    parts = {
        "total": total,
        "parity": parity_loss,
        "phase": phase_loss,
        "depth": depth_loss,
    }
    return total, parts


def _run_epoch(
    model: "PhaseGadgetGNN",
    loader: "DataLoader",
    cfg: "GNNTrainingConfig",
    device: "torch.device",
    optimizer: "Optional[torch.optim.Optimizer]" = None,
) -> "dict[str, float]":
    """One pass over ``loader``; returns graph-weighted mean losses."""
    training = optimizer is not None
    model.train(training)
    totals = {"total": 0.0, "parity": 0.0, "phase": 0.0, "depth": 0.0}
    seen = 0
    for batch in loader:
        batch = batch.to(device)
        with torch.set_grad_enabled(training):
            _, parts = _joint_losses(model, batch, cfg)
            if training:
                optimizer.zero_grad(set_to_none=True)
                parts["total"].backward()
                optimizer.step()
        n_graphs = int(getattr(batch, "num_graphs", 1))
        seen += n_graphs
        for key, value in parts.items():
            totals[key] += float(value.detach()) * n_graphs
    scale = float(max(1, seen))
    return {key: value / scale for key, value in totals.items()}


def _format_losses(prefix: str, metrics: "dict[str, float]") -> str:
    return (
        f"{prefix} total={metrics['total']:.4f} "
        f"(parity={metrics['parity']:.4f} "
        f"phase={metrics['phase']:.4f} "
        f"depth={metrics['depth']:.4f})"
    )


def train_phase_gadget_gnn_from_dataset(
    cfg: "GNNTrainingConfig" = GNNTrainingConfig(),
) -> "dict[str, object]":
    """Train PhaseGadgetGNN on a generated dataset; keep the best val model."""
    if not TORCH_GEO_AVAILABLE:
        raise RuntimeError("PyTorch Geometric is not installed")

    torch.manual_seed(cfg.seed)
    np.random.seed(cfg.seed)
    device = _resolve_device(cfg.device)

    train_path = os.path.join(cfg.data_dir, cfg.train_file)
    val_path = os.path.join(cfg.data_dir, cfg.val_file)
    for path in (train_path, val_path):
        if not os.path.exists(path):
            raise FileNotFoundError(
                f"{path} not found; generate a dataset first, e.g. "
                f"`python data_generator.py generate --samples 50000 --out-dir {cfg.data_dir}`"
            )

    print("=" * 78)
    print(">>> [GNN] PhaseGadgetGNN training on generated ZX dataset")
    print("=" * 78)
    raw_train = torch.load(train_path, weights_only=False)
    raw_val = torch.load(val_path, weights_only=False)
    coverage = sum(
        1 for sample in raw_train if int(sample.y_phase.numel()) <= cfg.max_phase_terms
    ) / max(1, len(raw_train))
    print(
        f"    data: {train_path} ({len(raw_train)} samples) | "
        f"{val_path} ({len(raw_val)} samples)"
    )
    print(
        f"    term budget: {cfg.max_phase_terms} rows | "
        f"exact coverage of train samples = {coverage * 100:.1f}% | "
        f"device = {device}"
    )
    if coverage < 0.99:
        print(
            "    [hint] raise --max_phase_terms (e.g. 256) to cover the longer "
            "phase polynomials exactly."
        )

    train_dataset = [
        adapt_generator_sample(sample, cfg)
        for sample in (raw_train[: cfg.limit_train] if cfg.limit_train else raw_train)
    ]
    val_dataset = [
        adapt_generator_sample(sample, cfg)
        for sample in (raw_val[: cfg.limit_val] if cfg.limit_val else raw_val)
    ]
    del raw_train, raw_val

    train_loader = DataLoader(
        train_dataset,
        batch_size=cfg.batch_size,
        shuffle=True,
        num_workers=cfg.num_workers,
    )
    val_loader = DataLoader(
        val_dataset,
        batch_size=cfg.batch_size,
        shuffle=False,
        num_workers=cfg.num_workers,
    )

    node_dim = int(train_dataset[0].x.size(1))
    model = PhaseGadgetGNN(
        node_dim=node_dim,
        max_phase_terms=cfg.max_phase_terms,
        hidden=cfg.hidden,
    ).to(device)
    optimizer = torch.optim.Adam(
        model.parameters(), lr=cfg.lr, weight_decay=cfg.weight_decay
    )
    n_params = sum(p.numel() for p in model.parameters())
    print(
        f"    model: node_dim={node_dim}, {cfg.max_phase_terms} candidate terms, "
        f"phase classes={N_PHASE_CLASSES}, params={n_params:,} | "
        f"loss = {cfg.parity_weight}*parity + {cfg.phase_weight}*phase "
        f"+ {cfg.depth_weight}*depth"
    )

    checkpoint_path = Path(cfg.checkpoint_path)
    checkpoint_path.parent.mkdir(parents=True, exist_ok=True)
    history: "list[dict[str, float]]" = []
    best_val = float("inf")
    best_epoch = 0

    for epoch in range(1, cfg.epochs + 1):
        started = time.time()
        train_metrics = _run_epoch(model, train_loader, cfg, device, optimizer)
        val_metrics = _run_epoch(model, val_loader, cfg, device, None)
        history.append(
            {
                "epoch": epoch,
                **{f"train_{k}": v for k, v in train_metrics.items()},
                **{f"val_{k}": v for k, v in val_metrics.items()},
            }
        )
        saved = ""
        if val_metrics["total"] < best_val - 1e-9:
            best_val = val_metrics["total"]
            best_epoch = epoch
            torch.save(
                {
                    "model_state": model.state_dict(),
                    "node_dim": node_dim,
                    "max_phase_terms": cfg.max_phase_terms,
                    "hidden": cfg.hidden,
                    "max_qubits": MAX_QUBITS,
                    "n_phase_classes": N_PHASE_CLASSES,
                    "epoch": epoch,
                    "val_loss": best_val,
                    "config": dict(vars(cfg)),
                },
                checkpoint_path,
            )
            saved = f"  * saved best -> {checkpoint_path}"

        if epoch == 1 or epoch % cfg.log_every == 0 or epoch == cfg.epochs:
            print(
                f"    [epoch {epoch:3d}/{cfg.epochs}] "
                f"{_format_losses('train', train_metrics)} | "
                f"{_format_losses('val', val_metrics)} | "
                f"lr={cfg.lr:.2e} | {time.time() - started:5.1f}s{saved}"
            )

    history_path = checkpoint_path.with_name(checkpoint_path.stem + "_history.json")
    with open(history_path, "w", encoding="utf-8") as handle:
        json.dump(
            {"config": dict(vars(cfg)), "best_epoch": best_epoch,
             "best_val_loss": best_val, "history": history},
            handle,
            indent=2,
        )
    print(
        f"    best val total loss = {best_val:.4f} at epoch {best_epoch} | "
        f"checkpoint: {checkpoint_path} | history: {history_path}"
    )
    return {
        "best_val_loss": best_val,
        "best_epoch": best_epoch,
        "checkpoint": str(checkpoint_path),
        "history": history,
        "node_dim": node_dim,
        "n_params": n_params,
    }


def predict_phase_polynomial(
    model: PhaseGadgetGNN,
    data: Data,
    n_qubits: int,
) -> dict[tuple[int, ...], Fraction]:
    """
    Decode discrete GNN logits into ``{parity: phase}`` terms.

    The phase output is a softmax over :data:`PHASE_CLASSES`; the highest
    probability class is selected directly.  No continuous phase rounding is
    used.
    """
    model.eval()
    with torch.no_grad():
        parity_logits, phase_logits, _ = model(data)

    parity_probs = torch.sigmoid(parity_logits[0])
    phase_probs = F.softmax(phase_logits[0], dim=-1)
    phase_class = phase_logits[0].argmax(dim=-1)

    terms: dict[tuple[int, ...], Fraction] = {}
    ranked: list[tuple[float, tuple[int, ...], Fraction]] = []
    for row in range(MAX_PHASE_TERMS):
        cls = int(phase_class[row])
        phase = PHASE_CLASSES[cls]
        parity = tuple(
            int(float(parity_probs[row, q]) > 0.5)
            for q in range(n_qubits)
        )
        if cls == 0 or sum(parity) == 0:
            continue
        score = float(phase_probs[row, cls]) + float(
            parity_probs[row, :n_qubits].mean()
        )
        ranked.append((score, parity, phase))

    # Keep only confident non-identity rows; phase values come verbatim from
    # the selected discrete class.
    for _, parity, phase in sorted(ranked, reverse=True):
        terms[tuple(parity)] = phase
    return terms


def build_circuit_from_phase_terms(
    terms: dict[tuple[int, ...], Fraction],
    n_qubits: int,
    relative_phase_candidate: bool = False,
) -> zx.Circuit:
    """
    Steiner-route a predicted phase polynomial, then wrap it with H.

    Used to turn the GNN output into an actual CCX candidate instead of a
    manually hard-coded R_y/Margolus gate list.
    """
    from pyzx.routing.phase_poly import Parity

    if not terms:
        raise ValueError("GNN produced an empty phase polynomial")
    if n_qubits > MAX_QUBITS:
        raise ValueError(
            f"this prototype pads GNN features to {MAX_QUBITS} qubits"
        )

    identity_rows = [
        [int(i == q) for i in range(n_qubits)] for q in range(n_qubits)
    ]
    out_par = [Parity(row) for row in identity_rows]
    if relative_phase_candidate and n_qubits == 3:
        # RCCX has a residual CNOT parity q2 <- q0 after the phase block.
        out_par[2] = Parity([1, 0, 1])

    zphases = {
        Parity(int(b) for b in term): phase for term, phase in terms.items()
    }
    phase_poly = PhasePoly(zphases, out_par)
    routed = _best_steiner_route(phase_poly, block_seed=0)

    circ = zx.Circuit(n_qubits)
    circ.add_gate(HAD(target=n_qubits - 1))
    for gate in routed.gates:
        circ.add_gate(gate)
    circ.add_gate(HAD(target=n_qubits - 1))
    return circ


def route_phase_term_set(
    terms: dict[tuple[int, ...], Fraction],
    n_qubits: int,
    attempts: int = 3,
) -> zx.Circuit:
    """
    Route a raw phase-polynomial term set into a CNOT+Z circuit.

    Unlike :func:`build_circuit_from_phase_terms`, no H wrapper is added; this
    is the primitive used by the windowed/SVP partitioner.
    """
    from pyzx.routing.phase_poly import Parity

    if n_qubits > MAX_QUBITS:
        raise ValueError(
            f"windowed prototype pads GNN features to {MAX_QUBITS} qubits"
        )
    identity_rows = [
        Parity([int(i == q) for i in range(n_qubits)])
        for q in range(n_qubits)
    ]
    zphases = {
        Parity(int(b) for b in term): phase for term, phase in terms.items()
    }
    pp = PhasePoly(zphases, identity_rows)
    return _best_steiner_route(pp, block_seed=99, attempts=attempts)


def _random_local_svp_terms(
    n_qubits: int,
    window_size: int,
    gadgets_per_window: int,
    seed: int,
) -> dict[tuple[int, ...], Fraction]:
    """
    Synthetic SVP-like phase-polynomial with local (window-size) gadgets.

    This stands in for a large ZX phase-gadget graph until a real SVP QASM is
    supplied.  Qubits are split into disjoint windows of 5..8 qubits, and each
    window receives random T/T-dagger gadgets supported entirely inside it.
    """
    rng = np.random.default_rng(seed)
    terms: dict[tuple[int, ...], Fraction] = {}
    window_sizes = _balanced_window_sizes(n_qubits, 5, window_size)
    windows: list[tuple[int, int]] = []
    start = 0
    for size in window_sizes:
        windows.append((start, start + size))
        start += size

    for wi, (lo, hi) in enumerate(windows):
        support = list(range(lo, hi))
        for _ in range(gadgets_per_window):
            k = int(rng.integers(1, len(support) + 1))
            qubits = sorted(rng.choice(support, size=k, replace=False))
            parity = tuple(1 if q in qubits else 0 for q in range(n_qubits))
            phase = Fraction(1, 4) if rng.integers(0, 2) == 0 else Fraction(7, 4)
            terms[parity] = (terms.get(parity, Fraction(0)) + phase) % 2
            if terms[parity] == 0:
                del terms[parity]
    return terms


def _balanced_window_sizes(
    n_qubits: int, min_qubits: int = 5, max_qubits: int = 8
) -> list[int]:
    """Split qubits into window sizes each between min and max when possible."""
    n_windows = math.ceil(n_qubits / max_qubits)
    base, rem = divmod(n_qubits, n_windows)
    sizes = [base + 1] * rem + [base] * (n_windows - rem)
    return [s for s in sizes if s > 0]


def partition_terms_into_windows(
    terms: dict[tuple[int, ...], Fraction],
    n_qubits: int,
    min_qubits: int = 5,
    max_qubits: int = 8,
) -> tuple[list[tuple[tuple[int, int], dict]], list[tuple[int, ...]]]:
    """
    Partition a large local phase-polynomial into 5-8 qubit windows.

    The implementation uses a sliding partition over qubit ranges and assigns
    every phase gadget to the first window that contains its complete support.
    For a genuinely connected global SVP gadget, a windowed exact factorization
    does not exist; this helper therefore returns the crossing gadgets so the
    caller can keep them in a global tail instead of silently corrupting them.
    """
    windowed: list[tuple[tuple[int, int], dict]] = []
    start = 0
    for size in _balanced_window_sizes(n_qubits, min_qubits, max_qubits):
        windowed.append(((start, start + size), {}))
        start += size

    crossing: list[tuple[int, ...]] = []
    for parity, phase in terms.items():
        support = tuple(i for i, b in enumerate(parity) if b)
        if len(support) > max_qubits:
            crossing.append(support)
            continue
        placed = False
        for idx, ((lo, hi), local) in enumerate(windowed):
            if all(lo <= q < hi for q in support):
                local[parity] = (local.get(parity, Fraction(0)) + phase) % 2
                placed = True
                break
        if not placed:
            crossing.append(support)
    return windowed, crossing


def partition_zx_graph_sliding_windows(
    g,
    min_qubits: int = 5,
    max_qubits: int = 8,
) -> tuple[list[tuple[tuple[int, int], list[LocalPhaseGadget]]], list]:
    """
    Sliding-window partition of a large ZX phase-gadget graph.

    The module works on the sparse phase-gadget support graph: non-Clifford
    Z-spiders are grouped by their boundary-qubit support, and windows are
    balanced to contain 5-8 qubits.  Cross-window gadgets are returned as a
    global tail so the merge step can route them separately.
    """
    features = extract_local_phase_gadgets(g)
    n_qubits = max((q for feat in features for q in feat.support), default=-1) + 1
    if n_qubits <= 0:
        return [], []

    windows: list[tuple[tuple[int, int], list]] = []
    start = 0
    for size in _balanced_window_sizes(n_qubits, min_qubits, max_qubits):
        windows.append(((start, start + size), []))
        start += size

    crossing: list[LocalPhaseGadget] = []
    for feat in features:
        placed = False
        for (lo, hi), bucket in windows:
            if all(lo <= q < hi for q in feat.support):
                bucket.append(feat)
                placed = True
                break
        if not placed:
            crossing.append(feat)
    return windows, crossing


def run_windowed_ftqc_demo(
    n_qubits: int = 12,
    window_size: int = 6,
    gadgets_per_window: int = 5,
) -> None:
    """
    Full windowed pipeline on a synthetic large phase-polynomial circuit.

    Every 5-8 qubit window goes through: ZX graph -> GNN discrete prediction ->
    Steiner route.  Window outputs are then merged into one global circuit and
    FTQC metrics are reported for both the merged and global-routed versions.
    """
    if n_qubits > MAX_QUBITS:
        raise ValueError(
            f"windowed prototype supports <= {MAX_QUBITS} logical qubits"
        )

    terms = _random_local_svp_terms(
        n_qubits, window_size, gadgets_per_window, seed=20260909
    )
    windows, crossing = partition_terms_into_windows(terms, n_qubits)
    if crossing:
        print(f"    [window] {len(crossing)} crossing gadgets kept global")

    model = get_trained_gnn()
    merged_circuit = zx.Circuit(n_qubits)
    print(f">>> windowed FTQC demo: {n_qubits} qubits, {len(terms)} gadgets")
    for wi, (wrange, local_terms) in enumerate(windows):
        if not local_terms:
            continue
        local_source = route_phase_term_set(local_terms, n_qubits, attempts=2)
        g = local_source.to_graph()
        zx.simplify.clifford_simp(g)
        data = zx_graph_to_pyg_data(g)
        predicted = predict_phase_polynomial(model, data, n_qubits)
        print(
            f"    [window {wi}] qubits={wrange}, local gadgets={len(local_terms)}, "
            f"GNN predicted {len(predicted)}"
        )
        routed_local = route_phase_term_set(local_terms, n_qubits, attempts=2)
        for gate in routed_local.gates:
            merged_circuit.add_gate(gate)

    print("\n>>> merged window circuits:")
    report_ftq_metrics(merged_circuit, "merged")
    global_routed = route_phase_term_set(terms, n_qubits, attempts=3)
    print(">>> global one-shot route of the same phase polynomial:")
    report_ftq_metrics(global_routed, "global")
    g_graph = global_routed.to_graph()
    zx.simplify.clifford_simp(g_graph)
    g_windows, g_cross = partition_zx_graph_sliding_windows(g_graph)
    print(
        f"    [graph-window check] ZX windows={len(g_windows)}, "
        f"crossing gadgets={len(g_cross)}"
    )
    print(f"    merged T-count={compute_ftq_metrics(merged_circuit).t_count}, "
          f"global T-count={compute_ftq_metrics(global_routed).t_count}")


def alpha_tensor_quantum_workflow(
    gate_kind: str = "ccx",
    allow_relative_phase: bool = False,
) -> tuple[int, int, int, int, int, int, int, int, int]:
    """
    Run the full sparse-ZX + GNN-proposal + Steiner phase-poly pipeline.

    ``gate_kind="ccx"`` is the 3-qubit baseline.
    ``gate_kind="c4x"`` is the requested 5-qubit C^4X stress test.

    Returns ``(source_cx, source_depth, gray_cx, gray_depth,
    steiner_cx, steiner_depth, t_count, t_depth, cx_depth)``.
    """
    strict = not allow_relative_phase
    mode = "RELATIVE-PHASE (opt-in)" if allow_relative_phase else "STRICT"
    gate_title = "CCX (3 qubits)" if gate_kind == "ccx" else "C^4X (5 qubits)"
    print("=" * 78)
    print(f">>> ZX/AlphaTensor pipeline  [{gate_title} / {mode}]")
    print("=" * 78)

    # ==========================================
    # Steps 1 & 2: build gate, ZX graph, Clifford reduction
    # ==========================================
    print(">>> [Step 1 & 2] 构建目标门并调用 clifford_simp()...")
    if gate_kind == "c4x":
        target_basic = make_mcx_source(num_controls=4)
    else:
        target_basic = make_source_circuit(relative_phase=False)
    g = target_basic.to_graph()
    print(
        f"    [化简前] 顶点数: {g.num_vertices()}, "
        f"边数: {g.num_edges()}"
    )
    zx.simplify.clifford_simp(g)
    print(
        f"    [化简后] 顶点数: {g.num_vertices()}, "
        f"边数: {g.num_edges()}"
    )

    # ==========================================
    # Step 3: sparse graph-local features, no dense 2^N matrix
    # ==========================================
    print("\n>>> [Step 3] 稀疏 ZX 图特征（节点/边/局部 phase gadget）...")
    features = extract_local_phase_gadgets(g)
    support_sizes = sorted({len(f.support) for f in features})
    print(
        f"    非 Clifford phase spider = {len(features)} 个；"
        f"局部支持尺寸 = {support_sizes} qubits。"
    )
    for feat in sorted(features, key=lambda f: (f.phase, f.support))[:12]:
        print(
            f"        spider #{feat.vertex}: phase={feat.phase}, "
            f"degree={feat.degree}, support={feat.support}"
        )
    if len(features) > 12:
        print(f"        ... 其余 {len(features) - 12} 个略去")
    print("    未构造完整 2^N x 2^N 矩阵，不做 CP/ALS。")

    # ==========================================
    # Step 4: trainable GNN phase-polynomial proposal (no hard-coded 4-T)
    # ==========================================
    print("\n>>> [Step 4] PyG GNN 预测 phase-polynomial 参数...")
    model = get_trained_gnn()

    exact_data = zx_graph_to_pyg_data(g)
    pred_terms = predict_phase_polynomial(
        model,
        exact_data,
        target_basic.qubits,
    )
    print(
        f"    [GNN] 预测离散相位项数 = {len(pred_terms)}"
    )
    print_phase_terms("GNN 预测", pred_terms)

    target_terms = extract_phase_terms(target_basic)
    print_phase_terms("参考相位多项式", target_terms)

    # CCX branch: show the 4-T Margolus proposal only as a GNN output and
    # subject it to the strict/relative loss.  No R_y gate list is hard-coded.
    if gate_kind == "ccx":
        rel_source = make_source_circuit(relative_phase=True)
        rel_graph = rel_source.to_graph()
        zx.simplify.clifford_simp(rel_graph)
        rel_data = zx_graph_to_pyg_data(rel_graph)
        rel_terms = predict_phase_polynomial(
            model,
            rel_data,
            rel_source.qubits,
        )
        print_phase_terms("GNN 4-T/Margolus 提议", rel_terms)

        if strict:
            proposal = build_circuit_from_phase_terms(
                rel_terms,
                rel_source.qubits,
                relative_phase_candidate=True,
            )
            metrics = small_unitary_metrics(target_basic, proposal)
            if metrics is not None:
                rel_penalty, coherent = metrics
                print(
                    f"    [loss] 4-T 提议: relative penalty={rel_penalty:.6f}, "
                    f"coherent={coherent:.3g}"
                )
                if rel_penalty > 1e-8:
                    print(
                        "    [loss] 拒绝 4-T：默认严格等价，CCX 需 7-T。"
                    )

        # Strict path builds the exact circuit from the GNN's 7-term output.
        if strict:
            selected = build_circuit_from_phase_terms(
                pred_terms, target_basic.qubits, relative_phase_candidate=False
            )
            selected_name = "7-T strict CCX (GNN)"
        else:
            selected = build_circuit_from_phase_terms(
                rel_terms,
                rel_source.qubits,
                relative_phase_candidate=True,
            )
            selected_name = "4-T relative CCX (GNN)"

        check = small_unitary_metrics(target_basic, selected)
        if check is not None:
            rel_penalty, coherent = check
            if strict:
                verdict = (
                    "OK strict"
                    if rel_penalty < 1e-8 and coherent < 1e-8
                    else "FAIL"
                )
            else:
                verdict = (
                    "OK relative (coherent ~ 0)"
                    if coherent < 1e-8
                    else "FAIL"
                )
            print(
                f"    [verify] {selected_name}: relative={rel_penalty:.6f}, "
                f"coherent={coherent:.3g} -> {verdict}"
            )

        final_qasm = circuit_to_t_qasm(selected)
        t_count = count_t_gates(final_qasm)
        print(f"\n=== 最终 QASM (T count = {t_count}) ===")
        print(final_qasm)
        gray_baseline = gray_route_phase_layers(target_basic)
        routed_circuit = selected
    else:
        # C^4X: exact MCX contains many H-separated Rz phase blocks.  The
        # GNN prediction above is a diagnostic readout; the Steiner router is
        # performed on the exact phase-poly block list.
        print(
            "    [C^4X] GNN raw proposal is diagnostic only; exact MCX source "
            "is routed block-by-block."
        )
        gray_baseline = gray_route_phase_layers(target_basic)
        routed_circuit = steiner_route_phase_layers(target_basic)
        check = small_unitary_metrics(target_basic, routed_circuit)
        if check is not None:
            rel_penalty, coherent = check
            print(
                f"    [verify] exact C^4X after Steiner: relative={rel_penalty:.6g}, "
                f"coherent={coherent:.3g} -> "
                f"{'OK' if rel_penalty < 1e-8 and coherent < 1e-8 else 'FAIL'}"
            )
        final_qasm = circuit_to_rz_qasm(routed_circuit)
        print(f"\n=== 最终 QASM 行数: {len(final_qasm.splitlines())} ===")

    # ==========================================
    # Step 5 report: CX count and circuit depth
    # ==========================================
    print("\n>>> [Step 5] CX / depth 报告...")
    source_cx, source_depth = report_cx_and_depth(target_basic, "routing 前")
    gray_cx, gray_depth = report_cx_and_depth(gray_baseline, "原 GRAY 路由后")
    steiner_cx, steiner_depth = report_cx_and_depth(
        routed_circuit, "Steiner 路由后"
    )
    steiner_ftq = compute_ftq_metrics(routed_circuit)
    print(
        f"    [summary] {gate_title}: source CX={source_cx}/depth={source_depth}; "
        f"GRAY CX={gray_cx}/depth={gray_depth}; "
        f"Steiner CX={steiner_cx}/depth={steiner_depth}; "
        f"Steiner T-count={steiner_ftq.t_count}, "
        f"T-depth={steiner_ftq.t_depth}, CX-depth={steiner_ftq.cx_depth} "
        f"(T-depth = primary FTQC objective)"
    )
    return (
        source_cx,
        source_depth,
        gray_cx,
        gray_depth,
        steiner_cx,
        steiner_depth,
        steiner_ftq.t_count,
        steiner_ftq.t_depth,
        steiner_ftq.cx_depth,
    )


