PHASE_EIGHTH = Fraction(1, 8)
RELATIVE_PHASE_LAMBDA = 10.0
MAX_QUBITS = 16
MAX_PHASE_TERMS = 64
GNN_HIDDEN = 32

# Discrete phase library.  k/16 * pi for k=0..31 covers I, Rz rotations,
# T(k=4), T-dagger(k=28), S/S-dagger and Z; the C^4X decomposition uses the
# k=1 and k=31 sixteenth-root rotations too.
PHASE_CLASSES = tuple(Fraction(k, 16) for k in range(32))
PHASE_CLASS_INDEX = {phase: k for k, phase in enumerate(PHASE_CLASSES)}
N_PHASE_CLASSES = len(PHASE_CLASSES)

# FTQC T-rotation definition: *any odd multiple of pi/4* needs exactly one T
# gate, because the even part is a free Clifford rotation:
#   pi/4  -> T
#   3pi/4 -> S . T
#   5pi/4 -> Z . T
#   7pi/4 -> T-dagger
# Counting only +-pi/4 (as the first revision did) undercounts every 3pi/4 and
# 5pi/4 rotation as zero T gates, which is what made the C^4X proposal report
# T-count 0 while it still contained a 5pi/4 rotation.
T_PHASES = (Fraction(1, 4), Fraction(3, 4), Fraction(5, 4), Fraction(7, 4))
T_DEPTH_LAMBDA = 1.0
T_COUNT_LAMBDA = 0.5


def _dump_qasm(qc: QuantumCircuit) -> str:
    if qasm2 is not None:
        return qasm2.dumps(qc)
    return qc.qasm()


def _is_non_clifford_phase(phase) -> bool:
    """ZX phase is a multiple of pi.  Clifford phases are multiples of pi/2."""
    p = Fraction(phase) % 2
    return (p * 2).denominator != 1


@dataclass(frozen=True)
class LocalPhaseGadget:
    """A sparse, graph-derived descriptor of one non-Clifford phase spider."""

    vertex: int
    phase: Fraction
    support: tuple[int, ...]
    degree: int
    neighbor_signature: tuple[tuple[str, str], ...]


def _gadget_support_qubits(g, start: int, max_depth: int = 5) -> tuple[int, ...]:
    """Return boundary qubits reachable from a spider without touching a matrix."""
    support: set[int] = set()
    seen = {start}
    frontier = [(start, 0)]
    while frontier:
        v, depth = frontier.pop()
        if depth >= max_depth:
            continue
        for w in g.neighbors(v):
            if w in seen:
                continue
            seen.add(w)
            if g.type(w) == zx.VertexType.BOUNDARY:
                q = g.qubit(w)
                if q >= 0:
                    support.add(q)
            else:
                frontier.append((w, depth + 1))
    if not support and g.qubit(start) >= 0:
        support.add(g.qubit(start))
    return tuple(sorted(support))


def extract_local_phase_gadgets(g) -> list[LocalPhaseGadget]:
    """Sparse graph scan; no dense matrix is ever materialized here."""
    features: list[LocalPhaseGadget] = []
    for v in g.vertices():
        if g.type(v) != zx.VertexType.Z:
            continue
        phase = Fraction(g.phase(v))
        if not _is_non_clifford_phase(phase):
            continue
        neighbors = list(g.neighbors(v))
        signature = tuple(
            sorted(
                (str(g.type(w)), str(Fraction(g.phase(w)))) for w in neighbors
            )
        )
        features.append(
            LocalPhaseGadget(
                vertex=v,
                phase=phase,
                support=_gadget_support_qubits(g, v),
                degree=len(neighbors),
                neighbor_signature=signature,
            )
        )
    return features


def make_source_circuit(relative_phase: bool) -> zx.Circuit:
    """
    Build the source circuit that we will route.

    ``relative_phase=False`` -> exact Qiskit/PyZX 7-T CCX.
    ``relative_phase=True``  -> Margolus/RCCX, exact only up to relative phases.
    """
    qc = QuantumCircuit(3)
    if relative_phase:
        # This is the standard 4-T relative-phase Toffoli (RCCX/Margolus),
        # NOT the old R_y version whose PyZX extraction inflated it to 6 Rz.
        qc.h(2)
        qc.t(2)
        qc.cx(1, 2)
        qc.tdg(2)
        qc.cx(0, 2)
        qc.t(2)
        qc.cx(1, 2)
        qc.tdg(2)
        qc.h(2)
    else:
        qc.ccx(0, 1, 2)
    circ = zx.Circuit.from_qasm(_dump_qasm(qc))
    return circ.to_basic_gates()


def _rccx_gates(control0: int, control1: int, target: int):
    """4-T Margolus / RCCX gates (exact Clifford+T, relative-phase Toffoli)."""
    return [
        ("h", target),
        ("t", target),
        ("cx", control1, target),
        ("tdg", target),
        ("cx", control0, target),
        ("t", target),
        ("cx", control1, target),
        ("tdg", target),
        ("h", target),
    ]


def relative_phase_mcx_circuit(num_controls: int) -> "QuantumCircuit":
    """Relative-phase C^nX ladder: same AND ladder, every Toffoli replaced by RCCX.

    Verified numerically (relative-phase criterion, see ``relative_phase_metrics``)
    for n = 2..6: the result differs from the exact gate only by a **diagonal
    +-1 (Clifford) correction**, while using ``4(2n-3)`` T gates instead of
    ``7(2n-3)`` -- a ~43% T-count reduction.
    """
    n_ancillas = max(0, num_controls - 2)
    total = num_controls + 1 + n_ancillas
    controls = list(range(num_controls))
    ancillas = list(range(num_controls, num_controls + n_ancillas))
    target = total - 1
    qc = QuantumCircuit(total)

    def emit(control0: int, control1: int, target_qubit: int) -> None:
        for gate in _rccx_gates(control0, control1, target_qubit):
            name = gate[0]
            if name == "cx":
                qc.cx(gate[1], gate[2])
            else:
                getattr(qc, name)(gate[1])

    if num_controls == 1:
        qc.cx(controls[0], target)
        return qc
    if num_controls == 2:
        emit(controls[0], controls[1], target)
        return qc
    emit(controls[0], controls[1], ancillas[0])
    for i in range(1, n_ancillas):
        emit(ancillas[i - 1], controls[i + 1], ancillas[i])
    emit(ancillas[-1], controls[-1], target)
    for i in reversed(range(1, n_ancillas)):
        emit(ancillas[i - 1], controls[i + 1], ancillas[i])
    emit(controls[0], controls[1], ancillas[0])
    return qc


def relative_phase_metrics(
    ideal: zx.Circuit,
    candidate: zx.Circuit,
    ancillas: "Optional[Sequence[int]]" = None,
    num_controls: "Optional[int]" = None,
):
    """Certified relative-phase acceptance test for two C^nX circuits.

    Computes ``U_ideal^dagger U_candidate`` on the clean-ancilla (=|0>) subspace;
    the candidate is relative-phase equivalent iff that matrix is **diagonal with
    unit modulus entries** (the Margolus/RCCX family differs from the exact gate
    only by such a diagonal Clifford correction).  Returns
    ``(offdiagonal_max, ||diag|-1| max)`` or ``None`` when the subspace is too
    large for a dense check.

    ``ancillas`` / ``num_controls`` must describe the circuit layout; inferring
    the controls from ``total - 1`` is wrong as soon as ancillas are present
    (e.g. C^4X has 4 controls and 2 ancillas on 7 qubits) and silently selects
    the wrong subspace.
    """
    try:
        import numpy as _np
        from qiskit import qasm2 as _qasm2
        from qiskit.quantum_info import Operator as _Operator
    except Exception:
        return None
    total = ideal.qubits
    if candidate.qubits != total or total > 11:
        return None
    import warnings as _warnings
    _warnings.warn(
        "relative_phase_metrics uses the RIGHT-multiplied convention "
        "(U_ideal^dagger U_candidate) and is wrong in BOTH directions: it "
        "false-rejects this project's left-multiplied construction and "
        "false-accepts right-multiplied ones (safe only for basis inputs). "
        "Use relative_phase_criterion.relative_phase_ok instead. "
        "See calibrate_truth_criterion.py.",
        DeprecationWarning, stacklevel=2)
    if ancillas is None:
        n_controls = int(num_controls) if num_controls is not None else total - 1
        n_ancillas = max(0, n_controls - 2)
        ancillas = list(range(n_controls, n_controls + n_ancillas))
    ancillas = [int(a) for a in ancillas]
    keep = [x for x in range(2 ** total) if all(not (x >> a) & 1 for a in ancillas)]
    a = _Operator(_qasm2.loads(candidate.to_qasm())).data[_np.ix_(keep, keep)]
    b = _Operator(_qasm2.loads(ideal.to_qasm())).data[_np.ix_(keep, keep)]
    correction = b.conj().T @ a
    offdiag = float(_np.max(_np.abs(correction - _np.diag(_np.diag(correction)))))
    unit = float(_np.max(_np.abs(_np.abs(_np.diag(correction)) - 1.0)))
    return offdiag, unit


def make_mcx_source(num_controls: int, basis: str = "rz", relative_phase: bool = False) -> zx.Circuit:
    """
    Build a multi-controlled X gate in a phase-polynomial-friendly gate set.

    ``basis="rz"`` (default): Qiskit's no-ancilla MCX synthesis transpiled into
    {H, CX, Rz}.  The circuit is exact, but its rotations are pi/8 / pi/16
    angles, i.e. *no* Clifford+T circuit can reproduce it exactly, so a T-count
    evaluation on this source is structurally meaningless (it always reads ~0).

    ``basis="clifford_t"``: an exact Toffoli AND-ladder on clean ancillas
    (``2n-1`` qubits).  Every rotation is a multiple of pi/4, so the source is
    genuinely Clifford+T and T-count / T-depth are well defined.  This is the
    correct target for evaluating a Clifford+T proposal.
    """
    if relative_phase:
        return zx.Circuit.from_qasm(_dump_qasm(relative_phase_mcx_circuit(num_controls))).to_basic_gates()
    if basis == "clifford_t":
        n_ancillas = max(0, num_controls - 2)
        n_qubits = num_controls + 1 + n_ancillas
        controls = list(range(num_controls))
        # Keep the *target on the highest qubit index*: the rest of the pipeline
        # (``build_circuit_from_phase_terms``) wraps the phase polynomial with
        # Hadamards on ``n_qubits - 1``, so the ancillas must sit below it.
        ancillas = list(range(num_controls, num_controls + n_ancillas))
        target = n_qubits - 1
        qc = QuantumCircuit(n_qubits)
        if num_controls == 1:
            qc.cx(controls[0], target)
        elif num_controls == 2:
            qc.ccx(controls[0], controls[1], target)
        else:
            qc.ccx(controls[0], controls[1], ancillas[0])
            for i in range(1, len(ancillas)):
                qc.ccx(ancillas[i - 1], controls[i + 1], ancillas[i])
            qc.ccx(ancillas[-1], controls[-1], target)
            for i in reversed(range(1, len(ancillas))):
                qc.ccx(ancillas[i - 1], controls[i + 1], ancillas[i])
            qc.ccx(controls[0], controls[1], ancillas[0])
        return zx.Circuit.from_qasm(_dump_qasm(qc)).to_basic_gates()
    if basis != "rz":
        raise ValueError(f"unknown MCX basis {basis!r} (use 'rz' or 'clifford_t')")
    n_qubits = num_controls + 1
    qc = QuantumCircuit(n_qubits)
    qc.append(MCXGate(num_controls), list(range(n_qubits)))
    qct = transpile(
        qc, basis_gates=["h", "cx", "rz"], optimization_level=1
    )
    return zx.Circuit.from_qasm(_dump_qasm(qct))


def _circuit_block(n_qubits: int, gates: Iterable) -> zx.Circuit:
    c = zx.Circuit(n_qubits)
    c.gates = list(gates)
    return c


def _phase_blocks(circuit: zx.Circuit) -> list[list]:
    """Split at Hadamard gates into CNOT+ZPhase phase-polynomial blocks."""
    blocks: list[list] = []
    current: list = []
    for gate in circuit.gates:
        if isinstance(gate, HAD):
            if current:
                blocks.append(current)
                current = []
        else:
            current.append(gate)
    if current:
        blocks.append(current)
    return blocks


def extract_phase_terms(circuit: zx.Circuit) -> dict[tuple[int, ...], Fraction]:
    """
    Track parities through CNOTs and collect Z phases (T/Tdg) per parity.

    This is the "phase polynomial" representation used by the Gray/Steiner
    phase-layer router.  The dictionary has one entry per non-Clifford
    rotation; no 2^N object is made.

    Note:
        The circuit is split at Hadamard gates and the *per-block* phase
        polynomials are merged into one dictionary.  That merge is only exact
        when the circuit is a single phase-polynomial block (no Hadamard in
        between).  For multi-block circuits -- e.g. a Toffoli ladder whose CCX
        decomposition contains Hadamards -- use
        :func:`steiner_route_phase_layers`, which routes block by block and
        preserves the Hadamard boundaries (a flattened reconstruction of such a
        circuit is not equivalent; measured relative penalty ~0.35).
    """
    n = circuit.qubits
    terms: dict[tuple[int, ...], Fraction] = {}
    blocks = _phase_blocks(circuit)
    if len(blocks) > 1:
        print(
            f"    [warn] extract_phase_terms: circuit has {len(blocks)} "
            "Hadamard-separated phase blocks; merging them into one phase "
            "polynomial is exact only for single-block circuits "
            "(use steiner_route_phase_layers for multi-block circuits)."
        )
    for block in blocks:
        if not all(isinstance(g, (CNOT, ZPhase)) for g in block):
            continue
        pp = PhasePoly.fromCircuit(_circuit_block(n, block))
        for parity, phase in pp.zphases.items():
            key = tuple(int(parity[i]) for i in range(n))
            terms[key] = (terms.get(key, Fraction(0)) + Fraction(phase)) % 2
            if terms[key] == 0:
                del terms[key]
    return terms


def _term_to_bitstring(term: tuple[int, ...]) -> str:
    return "".join(str(int(b)) for b in term)


def _phase_class_name(phase: Fraction) -> str:
    p = Fraction(phase) % 2
    names = {
        Fraction(0): "I",
        Fraction(1, 4): "T",
        Fraction(7, 4): "T†",
        Fraction(1, 2): "S",
        Fraction(3, 2): "S†",
        Fraction(1): "Z",
    }
    if p in names:
        return names[p]
    k = round(float(p) * 16) % 32
    return f"Rz({k}/16)"


def print_phase_terms(title: str, terms: dict[tuple[int, ...], Fraction]) -> None:
    print(f"    [{title}] phase-polynomial terms:")
    for term in sorted(terms):
        p = terms[term] % 2
        print(
            f"        parity {_term_to_bitstring(term)} "
            f"-> phase {p}  (~{_phase_class_name(p)})"
        )


def gray_route_phase_layers(circuit: zx.Circuit) -> zx.Circuit:
    """
    Replace CNOT+T/CZ-free phase layers by phase-polynomial Gray routing.

    This is deliberately NOT ``pyzx.extract_circuit``: it consumes the phase
    polynomial directly and never re-extracts arbitrary ZX graph fragments.
    """
    n = circuit.qubits
    out = zx.Circuit(n)
    current: list = []

    def flush() -> None:
        nonlocal current
        if not current:
            return
        block = _circuit_block(n, current)
        if all(isinstance(g, (CNOT, ZPhase)) for g in current):
            try:
                pp = PhasePoly.fromCircuit(block)
                routed = route_phase_poly(
                    pp,
                    None,
                    method=RoutingMethod.GRAY,
                    mode=ElimMode.GAUSS_MODE,
                )
            except Exception:
                routed = block
        else:
            routed = block
        for g in routed.gates:
            out.add_gate(g)
        current = []

    for gate in circuit.gates:
        if isinstance(gate, HAD):
            flush()
            out.add_gate(gate)
        else:
            current.append(gate)
    flush()
    return out


def _count_cnots(circuit: zx.Circuit) -> int:
    return sum(1 for gate in circuit.gates if isinstance(gate, CNOT))


def _best_steiner_route(
    phase_poly: PhasePoly,
    block_seed: int,
    attempts: int = 6,
) -> zx.Circuit:
    """
    Randomized Steiner-tree phase-polynomial routing.

    For each phase layer we run several Steiner-mode Gray/Meijer attempts on a
    fully connected architecture and keep the candidate that minimizes the
    FTQC objective ``(T-depth, CX-count)``.
    This is the low-CNOT heuristic replacement for the single
    ``RoutingMethod.GRAY + GAUSS`` call.
    """
    n_qubits = phase_poly.out_par[0].n_qubits()
    architecture = create_architecture(FULLY_CONNECTED, n_qubits=n_qubits)
    best: zx.Circuit | None = None
    best_score: tuple[int, int] | None = None

    for method in (RoutingMethod.GRAY_MEIJER, RoutingMethod.MEIJER):
        for attempt in range(attempts):
            np.random.seed(20_260_909 + block_seed * 100 + attempt)
            try:
                candidate = route_phase_poly(
                    phase_poly,
                    architecture,
                    method=method,
                    mode=ElimMode.STEINER_MODE,
                    root_heuristic=RootHeuristic.RECURSIVE,
                    split_heuristic=SplitHeuristic.RANDOM,
                )
            except Exception:
                continue
            metrics = compute_ftq_metrics(candidate)
            score = (metrics.t_depth, _count_cnots(candidate))
            if best_score is None or score < best_score:
                best = candidate
                best_score = score

    if best is None:
        # Last-resort Meijer+Steiner fallback if the randomized attempts all
        # fail; the default extraction path never falls back to GRAY.
        best = route_phase_poly(
            phase_poly,
            architecture,
            method=RoutingMethod.MEIJER,
            mode=ElimMode.STEINER_MODE,
        )
    return best


def steiner_route_phase_layers(
    circuit: zx.Circuit, attempts: int = 6
) -> zx.Circuit:
    """
    Route CNOT+T/Rz phase layers with the low-CNOT Steiner heuristic.

    Hadamard boundaries are preserved; each maximal CNOT+ZPhase block is
    replaced by :func:`_best_steiner_route`.
    """
    n = circuit.qubits
    out = zx.Circuit(n)
    current: list = []
    block_id = 0

    def flush() -> None:
        nonlocal current, block_id
        if not current:
            return
        block = _circuit_block(n, current)
        if all(isinstance(g, (CNOT, ZPhase)) for g in current):
            try:
                pp = PhasePoly.fromCircuit(block)
                routed = _best_steiner_route(pp, block_id, attempts=attempts)
                block_id += 1
            except Exception:
                routed = block
        else:
            routed = block
        for g in routed.gates:
            out.add_gate(g)
        current = []

    for gate in circuit.gates:
        if isinstance(gate, HAD):
            flush()
            out.add_gate(gate)
        else:
            current.append(gate)
    flush()
    return out


def _qasm_gate_names(phase: Fraction) -> tuple[str, ...]:
    """QASM gate sequence realising a Z-phase with the right T count.

    Odd multiples of pi/4 are one T gate plus a free Clifford rotation, so
    3pi/4 and 5pi/4 expand to a two-gate sequence (S.T and Z.T).  Phases that
    are *not* multiples of pi/4 cannot be realised in Clifford+T at all: they
    are reported instead of being silently emitted, because their T-count is
    undefined (they need finer-angle magic-state synthesis).
    """
    p = Fraction(phase) % 2
    if p == PHASE_EIGHTH * 2:      # +pi/4
        return ("t",)
    if p == Fraction(7, 4):        # -pi/4
        return ("tdg",)
    if p == Fraction(3, 4):        # +3pi/4 = S . T
        return ("t", "s")
    if p == Fraction(5, 4):        # +5pi/4 = Z . T
        return ("t", "z")
    if p == Fraction(1, 2):
        return ("s",)
    if p == Fraction(3, 2):
        return ("sdg",)
    if p == 0:
        return ()
    raise ValueError(
        f"phase {phase} is not a multiple of pi/4 and cannot be emitted as a "
        "Clifford+T gate (T-count is undefined for it; it needs finer-angle "
        "magic-state synthesis)"
    )


def circuit_to_t_qasm(circuit: zx.Circuit) -> str:
    """Custom QASM emitter: pi/4 Z-phases become literal T/Tdg gates."""
    lines = [
        "OPENQASM 2.0;",
        'include "qelib1.inc";',
        f"qreg q[{circuit.qubits}];",
    ]
    for gate in circuit.gates:
        if isinstance(gate, HAD):
            lines.append(f"h q[{gate.target}];")
        elif isinstance(gate, CNOT):
            lines.append(f"cx q[{gate.control}], q[{gate.target}];")
        elif isinstance(gate, ZPhase):
            for name in _qasm_gate_names(Fraction(gate.phase)):
                lines.append(f"{name} q[{gate.target}];")
        else:
            raise TypeError(f"unexpected gate: {gate!r}")
    return "\n".join(lines) + "\n"


def count_t_gates(qasm: str) -> int:
    return sum(
        1
        for line in qasm.splitlines()
        if line.startswith("t q") or line.startswith("tdg q")
    )


@dataclass(frozen=True)
class FTQMetrics:
    """FTQC report: T-count, optimized T-depth, CX-depth and fine-angle count."""

    t_count: int
    t_depth: int
    cx_depth: int
    fine_count: int = 0          # Z-phases that are not multiples of pi/4


def _is_t_gate(gate) -> bool:
    return isinstance(gate, ZPhase) and (
        Fraction(gate.phase) % 2 in T_PHASES
    )


def _gate_qubits(gate) -> tuple[int, ...]:
    if isinstance(gate, CNOT):
        return (gate.control, gate.target)
    if isinstance(gate, (HAD, ZPhase)):
        return (gate.target,)
    return ()


def _layered_depth(circuit: zx.Circuit, counted) -> int:
    """
    Conservative dataflow depth for a subset of gates.

    Counted gates (T or CX depending on the caller) each consume one layer.
    Non-counted Clifford/phase gates carry data dependencies forward but do
    not themselves consume depth.  Gates on disjoint qubits are placed in the
    same layer, which is the basic "phase spiders can fire in parallel"
    scheduling rule used below.
    """
    last_depth = [0] * circuit.qubits
    total_depth = 0
    for gate in circuit.gates:
        qubits = _gate_qubits(gate)
        if not qubits:
            continue
        start = max(last_depth[q] for q in qubits)
        end = start + (1 if counted(gate) else 0)
        for q in qubits:
            last_depth[q] = end
        total_depth = max(total_depth, end)
    return total_depth


def _t_parallel_schedule(circuit: zx.Circuit) -> tuple[int, list[tuple[int, ZPhase]]]:
    """
    Assign each T/T-dagger gate to an earliest parallel layer.

    Only T gates consume layers; commuting gates on different qubits share a
    layer.  This layer assignment is the scheduler whose result is reported as
    T-depth and is later fed into the GNN objective.
    """
    last_depth = [0] * circuit.qubits
    layers: list[tuple[int, ZPhase]] = []
    for gate in circuit.gates:
        qubits = _gate_qubits(gate)
        if not qubits:
            continue
        start = max(last_depth[q] for q in qubits)
        if _is_t_gate(gate):
            start += 1
            layers.append((start, gate))
        for q in qubits:
            last_depth[q] = start
    return (max((layer for layer, _ in layers), default=0), layers)


def compute_ftq_metrics(circuit: zx.Circuit) -> FTQMetrics:
    """Return T-count, scheduled T-depth, CX-depth and the fine-angle count.

    ``fine_count`` counts Z-phases that are *not* multiples of pi/4.  Such
    rotations cannot be implemented in Clifford+T at all, so they are excluded
    from the T-count (which would otherwise silently read 0 for a proposal that
    is full of pi/8 / pi/16 rotations) and reported separately.
    """
    t_count = sum(1 for g in circuit.gates if _is_t_gate(g))
    fine_count = sum(
        1
        for g in circuit.gates
        if isinstance(g, ZPhase)
        and (Fraction(g.phase) % 2 * 4).denominator != 1
    )
    t_depth, _ = _t_parallel_schedule(circuit)
    cx_depth = _layered_depth(circuit, lambda g: isinstance(g, CNOT))
    return FTQMetrics(
        t_count=t_count, t_depth=t_depth, cx_depth=cx_depth, fine_count=fine_count
    )


def report_ftq_metrics(circuit: zx.Circuit, label: str) -> FTQMetrics:
    metrics = compute_ftq_metrics(circuit)
    print(
        f"    [{label}] T-count={metrics.t_count}, "
        f"T-depth={metrics.t_depth}, CX-depth={metrics.cx_depth}, "
        f"fine-angle rotations={metrics.fine_count}"
    )
    if metrics.fine_count:
        print(
            f"        [warn] {metrics.fine_count} rotation(s) are not multiples of "
            "pi/4 -> the circuit is NOT Clifford+T, so its T-count is undefined "
            "(the rotations need finer-angle magic-state synthesis)."
        )
    return metrics


def circuit_to_rz_qasm(circuit: zx.Circuit) -> str:
    """QASM emitter for arbitrary Rz phase layers (used by the C^4X flow)."""
    lines = [
        "OPENQASM 2.0;",
        'include "qelib1.inc";',
        f"qreg q[{circuit.qubits}];",
    ]
    for gate in circuit.gates:
        if isinstance(gate, HAD):
            lines.append(f"h q[{gate.target}];")
        elif isinstance(gate, CNOT):
            lines.append(f"cx q[{gate.control}], q[{gate.target}];")
        elif isinstance(gate, ZPhase):
            angle = float(Fraction(gate.phase))
            lines.append(f"rz({angle:.12g}*pi) q[{gate.target}];")
        else:
            raise TypeError(f"unexpected gate: {gate!r}")
    return "\n".join(lines) + "\n"


def report_cx_and_depth(circuit: zx.Circuit, label: str) -> tuple[int, int]:
    """Load a circuit's QASM into Qiskit and report CX count and depth."""
    qasm = circuit_to_rz_qasm(circuit)
    qc = QuantumCircuit.from_qasm_str(qasm)
    ops = qc.count_ops()
    cx = int(ops.get("cx", 0))
    depth = int(qc.depth())
    print(f"    [{label}] CX = {cx}, depth = {depth}")
    ftq = report_ftq_metrics(circuit, f"{label} FTQC")
    return cx, depth


def small_unitary_metrics(
    target: zx.Circuit, candidate: zx.Circuit
) -> tuple[float, float] | None:
    """
    Small-support verification of the loss term.

    This is only for the small support of the MCX phase gadget (2^k x 2^k
    with k=3).  It is not a CP/ALS decomposition and is not used to optimize a
    full global unitary.
    """
    if target.qubits != candidate.qubits or target.qubits > 8:
        return None  # exponential matrix deliberately disabled
    ut = np.asarray(target.to_matrix(), dtype=complex)
    uc = np.asarray(candidate.to_matrix(), dtype=complex)
    d = ut.conj().T @ uc
    dim = d.shape[0]

    # Coherent error: non-diagonal residual after U_target^dagger U_candidate.
    coherent = float(
        np.linalg.norm(d - np.diag(np.diag(d)), ord="fro") / np.sqrt(dim)
    )

    # Relative phase penalty, made invariant to an irrelevant global phase.
    diagonal = np.diag(d)
    ref_angles = np.unique(np.round(np.angle(diagonal), decimals=10))
    best = float("inf")
    for ref in ref_angles:
        aligned = diagonal * np.exp(-1j * ref)
        penalty = np.sqrt(np.mean(np.abs(aligned - 1.0) ** 2))
        best = min(best, float(penalty))
    return best, coherent


def phase_term_mismatches(
    exact: dict[tuple[int, ...], Fraction],
    proposal: dict[tuple[int, ...], Fraction],
) -> int:
    keys = set(exact) | set(proposal)
    return sum(
        1
        for key in keys
        if (exact.get(key, Fraction(0)) % 2)
        != (proposal.get(key, Fraction(0)) % 2)
    )


def zx_graph_to_pyg_data(g) -> Data:
    """Convert a simplified ZX graph to a PyG ``Data`` with node/edge features."""
    if not TORCH_GEO_AVAILABLE:
        raise RuntimeError("PyTorch Geometric is not installed")

    vertices = list(g.vertices())
    vertex_index = {v: i for i, v in enumerate(vertices)}
    node_feats: list[list[float]] = []

    for v in vertices:
        typ = g.type(v)
        type_feat = [0.0, 0.0, 0.0]
        if typ == zx.VertexType.BOUNDARY:
            type_feat[0] = 1.0
        elif typ == zx.VertexType.Z:
            type_feat[1] = 1.0
        else:
            type_feat[2] = 1.0

        phase_pi = float(Fraction(g.phase(v))) * math.pi
        degree = len(list(g.neighbors(v)))
        qubit = g.qubit(v)
        qubit_feat = [0.0] * MAX_QUBITS
        if 0 <= qubit < MAX_QUBITS:
            qubit_feat[qubit] = 1.0

        phase = Fraction(g.phase(v))
        noncliff = (
            1.0 if _is_non_clifford_phase(phase) else 0.0
        )
        node_feats.append(
            type_feat
            + [math.cos(phase_pi), math.sin(phase_pi)]
            + [math.log1p(degree)]
            + qubit_feat
            + [noncliff]
        )

    edge_list: list[list[int]] = []
    edge_feats: list[list[float]] = []
    for edge in g.edges():
        u, v = edge[0], edge[1]
        edge_feat = (
            [1.0, 0.0]
            if g.edge_type(edge) == zx.EdgeType.SIMPLE
            else [0.0, 1.0]
        )
        for a, b in ((vertex_index[u], vertex_index[v]),
                     (vertex_index[v], vertex_index[u])):
            edge_list.append([a, b])
            edge_feats.append(edge_feat)

    return Data(
        x=torch.tensor(node_feats, dtype=torch.float),
        edge_index=torch.tensor(edge_list, dtype=torch.long).t().contiguous(),
        edge_attr=torch.tensor(edge_feats, dtype=torch.float),
    )


class PhaseGadgetGNN(nn.Module):
    """
    Small trainable GNN used as a stand-in for AlphaTensor's rank proposal.

    Node/edge features come from the simplified ZX graph.  The graph-level
    readout predicts:
      * parity bits per candidate phase term (binary logits), and
      * one discrete phase class per candidate term (softmax over the
        :data:`PHASE_CLASSES` library),
    emitted one term per step by an autoregressive GRU decoder seeded with the
    pooled graph embedding.  Training runs with teacher forcing
    (``target_sequence``), inference feeds the decoder's own predictions back.
    Besides the per-step parity/phase logits the decoder emits an explicit
    end-of-sequence logit (``out_stop``) and the pooled embedding predicts the
    sequence length (``out_count``), so stopping does not depend on the padding
    mask alone.

    ``node_dim`` and ``max_phase_terms`` default to the original hard-coded
    values (sparse-graph features, ``MAX_PHASE_TERMS`` candidate rows) so the
    legacy fixtures keep working; the dataset training pipeline passes the
    feature width of the generated dataset explicitly.
    """

    def __init__(
        self,
        node_dim: Optional[int] = None,
        max_phase_terms: int = MAX_PHASE_TERMS,
        hidden: int = GNN_HIDDEN,
        max_qubits: int = MAX_QUBITS,
    ):
        super().__init__()
        if node_dim is None:
            node_dim = 7 + MAX_QUBITS
        self.node_dim = int(node_dim)
        self.max_phase_terms = int(max_phase_terms)
        self.max_qubits = int(max_qubits)
        self.hidden = int(hidden)
        self.conv1 = GINEConv(
            nn.Sequential(
                nn.Linear(self.node_dim, self.hidden),
                nn.ReLU(),
                nn.Linear(self.hidden, self.hidden),
            ),
            edge_dim=2,
        )
        self.conv2 = GCNConv(self.hidden, self.hidden)
        self.depth_head = nn.Sequential(
            nn.Linear(self.hidden, self.hidden),
            nn.ReLU(),
            nn.Linear(self.hidden, 1),
        )
        # --- autoregressive decoder -----------------------------------------
        # One decoder step consumes the previous term as
        # ``[parity bits | phase one-hot]`` and updates the GRU state.
        self.decoder_input_dim = self.max_qubits + N_PHASE_CLASSES
        self.gru_cell = nn.GRUCell(self.decoder_input_dim, self.hidden)
        self.out_parity = nn.Linear(self.hidden, self.max_qubits)
        self.out_phase = nn.Linear(self.hidden, N_PHASE_CLASSES)
        # explicit end-of-sequence logit (one per step) so the decoder is
        # supervised *where to stop* instead of relying on the padding mask
        self.out_stop = nn.Linear(self.hidden, 1)
        # global sequence-length prediction head, read off the graph embedding
        self.out_count = nn.Sequential(
            nn.Linear(self.hidden, self.hidden),
            nn.ReLU(),
            nn.Linear(self.hidden, 1),
        )
        # per-step "a new Hadamard-separated phase block starts here" logit.
        # Without it the decoder can only express ONE H-framed phase polynomial,
        # while a Clifford+T source (e.g. a Toffoli ladder) has several
        # Hadamard-separated blocks: a single-block proposal is then structurally
        # unable to reproduce the source (measured relative penalty ~0.354 even
        # when fed the *true* flattened phase polynomial).
        self.out_block = nn.Linear(self.hidden, 1)

    def _graph_embedding(self, data: Data) -> "torch.Tensor":
        """Node features -> pooled graph embedding (the unchanged GNN trunk)."""
        h = F.relu(self.conv1(data.x, data.edge_index, data.edge_attr))
        h = F.relu(self.conv2(h, data.edge_index))
        batch = getattr(data, "batch", None)
        if batch is None:
            batch = torch.zeros(h.size(0), dtype=torch.long, device=h.device)
        return global_mean_pool(h, batch)

    @staticmethod
    def _start_token(batch_size: int, dim: int, device, dtype) -> "torch.Tensor":
        """Step-0 decoder input: an all-zero start token."""
        return torch.zeros((batch_size, dim), device=device, dtype=dtype)

    @classmethod
    def _prediction_token(
        cls,
        parity_logits: "torch.Tensor",
        phase_logits: "torch.Tensor",
        soft: bool = False,
    ) -> "torch.Tensor":
        """Feedback token built from the current predictions (inference mode).

        The hard variant mirrors what :func:`predict_phase_polynomial` decodes
        (parity thresholded at 0.5, argmax phase class); ``soft=True`` keeps the
        probabilities so the feedback stays differentiable.
        """
        if soft:
            parity_bits = torch.sigmoid(parity_logits)
            phase_token = F.softmax(phase_logits, dim=-1)
        else:
            parity_bits = (torch.sigmoid(parity_logits) > 0.5).to(parity_logits.dtype)
            phase_token = F.one_hot(
                phase_logits.argmax(dim=-1), num_classes=phase_logits.size(-1)
            ).to(phase_logits.dtype)
        return torch.cat([parity_bits, phase_token], dim=-1)

    def step_teacher_forcing(
        self, step: int, teacher_forcing_ratio: float
    ) -> float:
        """Linearly annealed teacher-forcing ratio for decoder ``step``.

        The schedule starts at ``teacher_forcing_ratio`` for step 0 and decays
        linearly to ``0.3 * teacher_forcing_ratio`` at the last step, i.e.

            decay_rate = 0.7 * teacher_forcing_ratio / max(1, T - 1)
            step_tf    = teacher_forcing_ratio - decay_rate * step

        Later steps therefore train the decoder on its own (free-running)
        tokens, which is what closes the teacher-forcing / inference gap.
        """
        cfg_ratio = float(teacher_forcing_ratio)
        decay_rate = 0.7 * cfg_ratio / max(1, self.max_phase_terms - 1)
        return cfg_ratio - decay_rate * int(step)

    def forward(
        self,
        data: Data,
        target_sequence: Optional["torch.Tensor"] = None,
        soft_feedback: bool = False,
        teacher_forcing_ratio: float = 1.0,
    ) -> tuple[
        torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor
    ]:
        """Decode ``max_phase_terms`` phase terms, optionally with teacher forcing.

        ``target_sequence`` has shape ``[B, T, max_qubits + N_PHASE_CLASSES]``;
        ``target_sequence[:, t, :]`` is the token fed in at step ``t + 1``
        (teacher forcing).  Without it the decoder feeds back its own
        predictions.  ``teacher_forcing_ratio < 1`` enables scheduled sampling:
        each step randomly feeds the ground-truth token with that probability
        and the model's own prediction otherwise, which closes the
        train/inference gap of a purely teacher-forced decoder.
        """
        pooled = self._graph_embedding(data)
        h_t = pooled
        token = self._start_token(
            pooled.size(0), self.decoder_input_dim, pooled.device, pooled.dtype
        )

        parity_steps: "list[torch.Tensor]" = []
        phase_steps: "list[torch.Tensor]" = []
        stop_steps: "list[torch.Tensor]" = []
        block_steps: "list[torch.Tensor]" = []
        for step in range(self.max_phase_terms):
            h_t = self.gru_cell(token, h_t)
            parity_logits_t = self.out_parity(h_t)
            phase_logits_t = self.out_phase(h_t)
            parity_steps.append(parity_logits_t)
            phase_steps.append(phase_logits_t)
            stop_steps.append(self.out_stop(h_t).squeeze(-1))
            block_steps.append(self.out_block(h_t).squeeze(-1))
            step_tf = self.step_teacher_forcing(step, teacher_forcing_ratio)
            if target_sequence is not None and step_tf > 0.0:
                if step_tf >= 1.0:
                    token = target_sequence[:, step, :]
                else:
                    free_running = self._prediction_token(
                        parity_logits_t, phase_logits_t, soft=soft_feedback
                    )
                    keep = (
                        torch.rand(
                            (parity_logits_t.size(0), 1),
                            device=parity_logits_t.device,
                            dtype=parity_logits_t.dtype,
                        )
                        < float(step_tf)
                    ).to(parity_logits_t.dtype)
                    token = keep * target_sequence[:, step, :] + (1.0 - keep) * free_running
            else:
                token = self._prediction_token(
                    parity_logits_t, phase_logits_t, soft=soft_feedback
                )

        parity_logits = torch.stack(parity_steps, dim=1)   # (B, T, max_qubits)
        phase_logits = torch.stack(phase_steps, dim=1)     # (B, T, N_PHASE_CLASSES)
        stop_logits = torch.stack(stop_steps, dim=1)       # (B, T)
        block_logits = torch.stack(block_steps, dim=1)     # (B, T)
        depth = F.softplus(self.depth_head(pooled)).squeeze(-1)
        count = F.softplus(self.out_count(pooled)).squeeze(-1)   # (B,) >= 0
        return parity_logits, phase_logits, depth, stop_logits, count, block_logits


def _phase_terms_to_label(
    terms: dict[tuple[int, ...], Fraction], n_qubits: int
) -> tuple[torch.Tensor, torch.Tensor]:
    """
    One-hot labels for parity and discrete phase class.

    Inactive padded rows use the identity class (index 0) and zero parity.
    """
    parity = np.zeros((MAX_PHASE_TERMS, MAX_QUBITS), dtype=np.float32)
    onehot = np.zeros(
        (MAX_PHASE_TERMS, N_PHASE_CLASSES), dtype=np.float32
    )
    for row, (term, phase) in enumerate(sorted(terms.items())[:MAX_PHASE_TERMS]):
        for q in range(min(n_qubits, MAX_QUBITS)):
            parity[row, q] = int(term[q])
        cls = PHASE_CLASS_INDEX[Fraction(phase) % 2]
        onehot[row, cls] = 1.0
    return torch.from_numpy(parity), torch.from_numpy(onehot)


def _make_gnn_training_examples() -> list[Data]:
    examples: list[Data] = []
    fixtures = [
        ("ccx_strict", False, None),
        ("ccx_relative", True, None),
        ("c4x", False, 4),
    ]
    for _, relative, controls in fixtures:
        if controls is None:
            source = make_source_circuit(relative_phase=relative)
        else:
            source = make_mcx_source(controls)
        g = source.to_graph()
        zx.simplify.clifford_simp(g)
        terms = extract_phase_terms(source)
        data = zx_graph_to_pyg_data(g)
        data.y_parity, data.y_phase = _phase_terms_to_label(
            terms, source.qubits
        )
        data.y_count = float(len(terms))
        # Feedback: route the reference decomposition with the same Steiner
        # backend used downstream, then keep its scheduled T-depth as target.
        routed_ref = steiner_route_phase_layers(source)
        data.y_depth = float(compute_ftq_metrics(routed_ref).t_depth)
        examples.append(data)
    return examples


def train_phase_gadget_gnn(
    epochs: int = 600, teacher_forcing_ratio: float = 1.0
) -> PhaseGadgetGNN:
    """
    Train phase classification with cross-entropy; T-count/T-depth enter as
    non-phase auxiliary objectives (no continuous phase regression).

    Parity rows use binary cross-entropy; each phase row is a one-hot class
    over the discrete sixteenth-root phase library.
    """
    if not TORCH_GEO_AVAILABLE:
        raise RuntimeError("PyTorch Geometric is not installed")

    torch.manual_seed(0)
    examples = _make_gnn_training_examples()
    batch = Batch.from_data_list(examples)
    y_parity = torch.stack([d.y_parity for d in examples])
    y_phase = torch.stack([d.y_phase for d in examples])
    y_count = torch.tensor([d.y_count for d in examples], dtype=torch.float)
    y_depth = torch.tensor([d.y_depth for d in examples], dtype=torch.float)
    phase_targets = y_phase.argmax(dim=-1).reshape(-1)

    model = PhaseGadgetGNN()
    optimizer = torch.optim.Adam(model.parameters(), lr=0.01)

    for epoch in range(1, epochs + 1):
        model.train()
        optimizer.zero_grad()
        target_sequence = build_target_sequence(y_parity, y_phase.argmax(dim=-1))
        pred_parity, pred_phase, pred_depth, stop_logits, _count_pred, _block_logits = model(
            batch,
            target_sequence=target_sequence,
            teacher_forcing_ratio=teacher_forcing_ratio,
        )
        parity_loss = F.binary_cross_entropy_with_logits(
            pred_parity, y_parity
        )
        phase_loss = F.cross_entropy(
            pred_phase.reshape(-1, N_PHASE_CLASSES),
            phase_targets,
        )
        # Differentiable surrogate for the achieved T-count: sum of
        # non-identity class probabilities.
        active_count = (
            1.0 - F.softmax(pred_phase, dim=-1)[..., 0]
        ).sum(dim=-1)
        count_loss = T_COUNT_LAMBDA * F.mse_loss(active_count, y_count)
        depth_loss = T_DEPTH_LAMBDA * F.smooth_l1_loss(
            pred_depth, y_depth
        )
        # explicit stop supervision: 1 at the first padded row of each graph
        seq_len = (y_phase.argmax(dim=-1) != 0).sum(dim=-1)
        stop_target = torch.zeros_like(stop_logits)
        has_stop = seq_len < stop_logits.size(1)
        if bool(has_stop.any()):
            stop_target[has_stop, seq_len[has_stop]] = 1.0
        stop_loss = F.binary_cross_entropy_with_logits(stop_logits, stop_target)
        loss = parity_loss + phase_loss + count_loss + depth_loss + stop_loss
        loss.backward()
        optimizer.step()
        if epoch == 1 or epoch % 50 == 0:
            print(
                f"    [GNN train] epoch={epoch:3d} loss={loss.item():.4f} "
                f"phase_CE={phase_loss.item():.4f} "
                f"parity_BCE={parity_loss.item():.4f} "
                f"count={count_loss.item():.4f} depth={depth_loss.item():.4f}"
                f" stop={stop_loss.item():.4f}"
            )
    return model


_TRAINED_GNN: "PhaseGadgetGNN | None" = None


def get_trained_gnn(
    epochs: int = 600, teacher_forcing_ratio: float = 1.0
) -> PhaseGadgetGNN:
    global _TRAINED_GNN
    if _TRAINED_GNN is None:
        _TRAINED_GNN = train_phase_gadget_gnn(
            epochs=epochs, teacher_forcing_ratio=teacher_forcing_ratio
        )
    return _TRAINED_GNN


# ===========================================================================
# Dataset-driven PhaseGadgetGNN training
#
# Consumes the ``train.pt`` / ``val.pt`` files written by ``data_generator.py``
# (node features ``x`` + ``x_support``, per-term ``y_parity`` / ``y_phase``
# labels in the 32-class pi/16 grid, plus ``y_depth``) and trains the graph net
# with the joint objective
#
#     total = parity_weight * BCEWithLogits
#           + phase_weight  * CrossEntropy(32 classes)
#           + depth_weight  * SmoothL1
# ===========================================================================


@dataclass
class GNNTrainingConfig:
    """Configuration for :func:`train_phase_gadget_gnn_from_dataset`."""

    data_dir: str = "full_dataset"
    train_file: str = "train.pt"
    val_file: str = "val.pt"
    epochs: int = 60
    batch_size: int = 64
    lr: float = 1e-3
    weight_decay: float = 0.0
    parity_weight: float = 1.0
    parity_pos_weight: float = 1.0
    parity_pos_weighting: str = "none"   # "none" | "bit_balanced" (per-qubit auto weights)
    parity_pos_weight_clamp: float = 10.0   # 50 over-fired the sparse qubits
    phase_weight: float = 1.0
    depth_weight: float = 0.5
    pad_loss_weight: float = 0.0   # >0 softly supervises padded steps (EOS signal)
    phase_class_weighting: str = "none"   # "none" | "inv_freq" (class-imbalanced CE)
    teacher_forcing_ratio: float = 1.0    # 1.0 = pure teacher forcing, <1 = scheduled sampling
    stop_weight: float = 1.0       # explicit EOS (stop) BCE weight
    stop_pos_weight: float = 0.0   # 0.0 = auto balance (neg/pos), else fixed weight
    count_weight: float = 0.1      # sequence-length head weight
    stop_threshold: float = 0.5    # inference stop threshold
    block_weight: float = 0.2      # phase-block boundary BCE weight
    parity_reg_weight: float = 0.5  # penalty on all-zero parity rows (relu(1 - sum p))
    # "auto" = require the row's *target* support (a constant never binds: the
    # model's sigmoid sum over the active qubits is already > 1 early on).
    parity_reg_target: "float | str" = "auto"
    max_phase_terms: int = MAX_PHASE_TERMS
    hidden: int = GNN_HIDDEN
    seed: int = 0
    device: str = "auto"
    checkpoint_path: str = "./checkpoints/best_gnn.pt"
    num_workers: int = 0
    limit_train: Optional[int] = None
    limit_val: Optional[int] = None
    log_every: int = 1


def _resolve_device(spec: str) -> "torch.device":
    if spec == "auto":
        return torch.device("cuda" if torch.cuda.is_available() else "cpu")
    return torch.device(spec)


def _generator_node_features(
    sample: Data, max_qubits: int = MAX_QUBITS
) -> "torch.Tensor":
    """Generator node features plus a fixed-width per-qubit support mask."""
    x = sample.x.float()
    support = torch.zeros((x.size(0), max_qubits), dtype=torch.float)
    raw_support = getattr(sample, "x_support", None)
    if raw_support is not None and raw_support.numel():
        if int(raw_support.size(1)) > max_qubits:
            raise ValueError(
                f"sample has {raw_support.size(1)} support columns but the model "
                f"supports {max_qubits}; regenerate the dataset with a matching width"
            )
        width = min(max_qubits, int(raw_support.size(1)))
        support[:, :width] = raw_support[:, :width].float()
    return torch.cat([x, support], dim=1)


def _generator_edge_attr(sample: Data) -> "torch.Tensor":
    """One-hot edge features: column 0 = simple (CNOT-like), 1 = Hadamard."""
    etype = getattr(sample, "edge_type", None)
    n_edges = int(sample.edge_index.size(1))
    if etype is None or etype.numel() != n_edges:
        return torch.zeros((n_edges, 2), dtype=torch.float)
    return F.one_hot(etype.long().clamp(0, 1), num_classes=2).float()


def _term_targets(
    sample: Data, max_terms: int, max_qubits: int = MAX_QUBITS
) -> "tuple[torch.Tensor, torch.Tensor, int, torch.Tensor, torch.Tensor]":
    """Re-fit the generator's canonical target sequence to the model budget.

    ``data_generator.py`` already emits ``y_parity`` / ``y_phase`` in canonical
    order (``GenConfig.term_order``: block order then descending phase magnitude
    by default) and zero padded to its own row budget, with ``y_seq_len``
    telling how many rows are real.  That order is what an autoregressive
    decoder has to follow, so it is preserved verbatim here -- only cropping /
    re-padding to the model's ``max_terms`` is done.

    Datasets written by an older generator have no ``y_seq_len`` and store one
    row per term in block order; those are canonicalised on the fly with the
    generator's default key (block index, then descending |phase|, then
    parity).  Returns ``(parity, phase_idx, seq_len, stop, blocks)`` where
    ``stop`` is the explicit end-of-sequence target (one 1 at the first padding
    step) and ``blocks`` holds the per-row source block index from the generator
    (``-1`` on padding), which supervises the phase-block boundaries.
    """
    parity = torch.zeros((1, max_terms, max_qubits), dtype=torch.float)
    phase_idx = torch.zeros((1, max_terms), dtype=torch.long)
    stop = torch.zeros((1, max_terms), dtype=torch.float)
    blocks_t = torch.full((1, max_terms), -1, dtype=torch.long)
    rows_parity = sample.y_parity
    rows_phase = sample.y_phase
    if rows_parity is None or rows_parity.numel() == 0:
        return parity, phase_idx, 0, stop, blocks_t
    n_rows = int(rows_parity.size(0))
    if int(rows_parity.size(1)) > max_qubits:
        raise ValueError(
            f"sample has {rows_parity.size(1)} parity columns but the model supports "
            f"{max_qubits}; regenerate the dataset with a matching width instead of "
            "silently truncating the parity targets"
        )
    width = min(max_qubits, int(rows_parity.size(1)))
    seq_attr = getattr(sample, "y_seq_len", None)
    if seq_attr is not None:
        # canonical ordering already enforced by data_generator.py
        seq_src = max(0, min(int(seq_attr), n_rows))
        order = list(range(seq_src))
        src_blocks = getattr(sample, "y_block", None)
        use_file_blocks = src_blocks is not None and int(src_blocks.numel()) == n_rows
        row_blocks = (
            [int(b) for b in src_blocks[:seq_src].tolist()]
            if use_file_blocks
            else [0] * seq_src
        )
    else:
        # legacy split: canonicalise now (block, descending |phase|, parity)
        blocks = getattr(sample, "y_block", None)
        have_blocks = blocks is not None and int(blocks.numel()) == n_rows
        ranked = []
        for row in range(n_rows):
            parity_value = 0
            for q in range(width):
                if int(rows_parity[row, q]):
                    parity_value |= 1 << q
            block = int(blocks[row]) if have_blocks else 0
            cls = int(rows_phase[row]) % N_PHASE_CLASSES
            magnitude = min(cls, N_PHASE_CLASSES - cls)
            ranked.append((block, -magnitude, -parity_value, cls, row))
        ranked.sort()
        order = [entry[-1] for entry in ranked]
        row_blocks = [entry[0] for entry in ranked]

    kept = min(len(order), max_terms)
    for slot, row in enumerate(order[:kept]):
        parity[0, slot, :width] = rows_parity[row, :width].float()
        phase_idx[0, slot] = int(rows_phase[row]) % N_PHASE_CLASSES
        blocks_t[0, slot] = int(row_blocks[row])
    if kept < max_terms:
        # explicit EOS: either the real end of the sequence or the end of the
        # generator's own budget (no stop inside a truncated window).
        stop[0, kept] = 1.0
    return parity, phase_idx, kept, stop, blocks_t


def adapt_generator_sample(
    sample: Data, cfg: "GNNTrainingConfig" = GNNTrainingConfig()
) -> Data:
    """Convert one ``data_generator.py`` sample into a PhaseGadgetGNN input."""
    x = _generator_node_features(sample)
    data = Data(
        x=x,
        edge_index=sample.edge_index.long(),
        edge_attr=_generator_edge_attr(sample),
    )
    parity, phase_idx, seq_len, stop, blocks = _term_targets(sample, cfg.max_phase_terms)
    data.y_parity = parity          # (1, T, Q) float -> batches to (B, T, Q)
    data.y_phase_idx = phase_idx    # (1, T) long   -> batches to (B, T)
    data.y_seq_len = torch.tensor([seq_len], dtype=torch.long)
    data.y_stop = stop              # (1, T) float  -> batches to (B, T)
    # phase-block boundary targets: 1 on the first row and wherever the source
    # block changes (lets the decoder emit multi-block proposals)
    new_block = torch.zeros((1, cfg.max_phase_terms), dtype=torch.float)
    row_block_ids = blocks[0, : max(0, seq_len)].tolist()
    for t, block_id in enumerate(row_block_ids):
        if t == 0 or block_id != row_block_ids[t - 1]:
            new_block[0, t] = 1.0
    data.y_new_block = new_block
    depth = getattr(sample, "y_depth", None)
    if depth is None:
        depth = (sample.metadata or {}).get("t_depth", 0.0)
    data.y_depth = torch.as_tensor(depth, dtype=torch.float).reshape(1)
    # keep a few provenance scalars; the raw dict also carries the QASM string,
    # which would be shipped through every batch for no benefit
    raw_meta = getattr(sample, "metadata", None) or {}
    data.metadata = {
        key: raw_meta.get(key)
        for key in ("family", "n_qubits", "optimality_level", "split", "t_depth")
    }
    data.n_terms_raw = int(sample.y_phase.numel())
    return data


def load_generator_split(
    path: str,
    cfg: "GNNTrainingConfig" = GNNTrainingConfig(),
    limit: Optional[int] = None,
) -> "list[Data]":
    """Load one ``*.pt`` split written by ``data_generator.py``."""
    if not TORCH_GEO_AVAILABLE:
        raise RuntimeError("PyTorch Geometric is not installed")
    raw = torch.load(path, weights_only=False)
    if limit is not None and limit > 0:
        raw = raw[:limit]
    return [adapt_generator_sample(sample, cfg) for sample in raw]


def _joint_losses(
    model: "PhaseGadgetGNN",
    batch: Data,
    cfg: "GNNTrainingConfig",
    phase_class_weights: "Optional[torch.Tensor]" = None,
    parity_pos_weights: "Optional[torch.Tensor]" = None,
    parity_active_bits: "Optional[torch.Tensor]" = None,
) -> "tuple[torch.Tensor, dict[str, torch.Tensor]]":
    """Teacher-forced, length-masked parity / phase / depth objective.

    The decoder is run autoregressively with teacher forcing: the token fed in
    at step ``t + 1`` is the ground-truth ``[parity bits | phase one-hot]`` of
    step ``t`` (start token at step 0).  Losses are only accumulated for steps
    ``t < y_seq_len``; padded steps are masked out of both the BCE and the
    cross-entropy.
    """
    y_parity = batch.y_parity.float()                    # (B, T, Q)
    y_phase = batch.y_phase_idx.long()                   # (B, T)
    y_depth = batch.y_depth.float().reshape(-1)          # (B,)
    seq_len = batch.y_seq_len.reshape(-1).long()         # (B,)
    batch_size, n_steps = y_parity.shape[:2]
    if n_steps != int(model.max_phase_terms):
        raise ValueError(
            f"dataset row budget ({n_steps}) != model max_phase_terms "
            f"({int(model.max_phase_terms)}); adapt the data with the checkpoint's "
            "value (GNNTrainingConfig.max_phase_terms = checkpoint['max_phase_terms'])"
        )

    # --- teacher forcing input: [parity | one-hot phase] of the previous step
    target_sequence = build_target_sequence(y_parity, y_phase)
    (
        parity_logits,
        phase_logits,
        depth_pred,
        stop_logits,
        count_pred,
        block_logits,
    ) = model(
        batch,
        target_sequence=target_sequence,
        teacher_forcing_ratio=cfg.teacher_forcing_ratio,
    )

    # --- step mask: step t is supervised only for t < y_seq_len ------------
    steps = torch.arange(n_steps, device=parity_logits.device).unsqueeze(0)
    step_mask = (steps < seq_len.unsqueeze(1)).to(parity_logits.dtype)   # (B, T)
    # ``pad_loss_weight`` (default 0.0) optionally keeps a weak signal on the
    # padded steps so the decoder also learns where to stop; the requested
    # behaviour (padded steps fully masked out) is the default.
    if cfg.pad_loss_weight > 0:
        step_weight = step_mask + float(cfg.pad_loss_weight) * (1.0 - step_mask)
    else:
        step_weight = step_mask
    denom = step_weight.sum().clamp(min=1.0)

    # parity bits are sparse (~6% positives on the generated data); the
    # positive-class weight keeps the BCE from collapsing onto "all zeros".
    # Either a per-qubit vector (``parity_pos_weighting="bit_balanced"``) or the
    # scalar ``cfg.parity_pos_weight`` (1.0 = plain BCEWithLogitsLoss) is used.
    if parity_pos_weights is not None:
        pos_weight: "torch.Tensor | float" = parity_pos_weights.to(
            device=parity_logits.device, dtype=parity_logits.dtype
        )
    else:
        pos_weight = torch.as_tensor(
            float(cfg.parity_pos_weight),
            dtype=parity_logits.dtype,
            device=parity_logits.device,
        )
    parity_raw = F.binary_cross_entropy_with_logits(
        parity_logits, y_parity, pos_weight=pos_weight, reduction="none"
    )                                                                    # (B, T, Q)
    parity_loss = (parity_raw * step_weight.unsqueeze(-1)).sum() / (
        denom * max(1, parity_logits.size(-1))
    )

    # --- all-zero-row regularizer ------------------------------------------
    # Penalise rows whose predicted parity is empty (relu(1 - sum_q p_q)), so
    # the decoder cannot satisfy the BCE by emitting "no term" everywhere.
    # ``parity_active_bits`` keeps the sum on the qubits the circuits actually
    # use; without it the sum runs over the whole padded qubit dimension.
    parity_probs = torch.sigmoid(parity_logits)
    if parity_active_bits is not None:
        active = parity_active_bits.to(device=parity_probs.device).bool()
        row_sums = parity_probs[..., active].sum(dim=-1)      # (B, T)
    else:
        row_sums = parity_probs.sum(dim=-1)                   # (B, T)
    # ``parity_reg_target`` is the required expected number of 1-bits per row.
    # With the default "auto" it is the *target support* of that row, so the
    # penalty actually binds (a constant 1.0 never does: the sigmoid sum over
    # the active qubits is already > 1 early in training).
    if isinstance(cfg.parity_reg_target, str) and cfg.parity_reg_target == "auto":
        # "auto" = the intended all-zero-row guard: require *one* bit on the rows
        # that must carry a term (requiring the full support instead over-fires
        # the head: measured predicted support 4.85 vs true 1.58 bits/row).
        reg_target = (y_parity.sum(dim=-1) > 0).to(row_sums.dtype)
    elif isinstance(cfg.parity_reg_target, str) and cfg.parity_reg_target == "support":
        reg_target = y_parity.sum(dim=-1)                    # (B, T) target support
    else:
        reg_target = torch.as_tensor(
            float(cfg.parity_reg_target), dtype=row_sums.dtype, device=row_sums.device
        )
    parity_reg = F.relu(reg_target - row_sums)
    parity_reg_loss = (parity_reg * step_weight).sum() / denom

    # --- phase-block boundary supervision -----------------------------------
    # A Clifford+T circuit is a sequence of Hadamard-separated phase blocks; the
    # decoder must mark where each block starts, otherwise its (single-block)
    # proposal can never reproduce the source.
    block_target = getattr(batch, "y_new_block", None)
    if block_target is not None:
        block_target = block_target.to(block_logits.dtype)
        n_pos = (block_target * step_weight).sum().clamp(min=1.0)
        n_neg = (step_weight.sum() - n_pos).clamp(min=1.0)
        block_pos_weight = (n_neg / n_pos).clamp(1.0, 50.0)
        block_raw = F.binary_cross_entropy_with_logits(
            block_logits, block_target, pos_weight=block_pos_weight, reduction="none"
        )
        block_loss = (block_raw * step_weight).sum() / denom
    else:
        block_loss = torch.zeros((), dtype=parity_logits.dtype, device=parity_logits.device)

    phase_raw = F.cross_entropy(
        phase_logits.reshape(-1, N_PHASE_CLASSES),
        y_phase.reshape(-1),
        weight=phase_class_weights,
        reduction="none",
    ).reshape(batch_size, n_steps)                                       # (B, T)
    phase_loss = (phase_raw * step_weight).sum() / denom

    # --- explicit end-of-sequence supervision ------------------------------
    # The stop target is 1 exactly at the first padding step (derived from the
    # sequence length, i.e. the same convention as data.y_stop on the generator
    # side); the stop step itself is supervised, everything after is masked.
    stop_target = torch.zeros_like(step_mask)
    has_stop = seq_len < n_steps
    if bool(has_stop.any()):
        stop_target[has_stop, seq_len[has_stop]] = 1.0
    stop_mask = ((steps <= seq_len.unsqueeze(1)) & (steps < n_steps)).to(
        stop_logits.dtype
    )
    # only ~1 in y_seq_len steps is a stop, so the BCE needs a positive weight;
    # 0.0 asks for the auto-balanced value (#negatives / #positives).
    if cfg.stop_pos_weight > 0:
        stop_pos_weight = torch.as_tensor(
            float(cfg.stop_pos_weight), dtype=stop_logits.dtype, device=stop_logits.device
        )
    else:
        n_pos = stop_target.sum().clamp(min=1.0)
        n_neg = (stop_mask.sum() - stop_target.sum()).clamp(min=1.0)
        stop_pos_weight = n_neg / n_pos
    stop_raw = F.binary_cross_entropy_with_logits(
        stop_logits, stop_target, pos_weight=stop_pos_weight, reduction="none"
    )
    stop_loss = (stop_raw * stop_mask).sum() / stop_mask.sum().clamp(min=1.0)

    # --- sequence-length regression head -----------------------------------
    count_loss = F.smooth_l1_loss(
        count_pred.reshape(-1), seq_len.to(count_pred.dtype)
    )

    depth_loss = F.smooth_l1_loss(depth_pred.reshape(-1), y_depth)
    total = (
        cfg.parity_weight * parity_loss
        + cfg.parity_reg_weight * parity_reg_loss
        + cfg.block_weight * block_loss
        + cfg.phase_weight * phase_loss
        + cfg.stop_weight * stop_loss
        + cfg.count_weight * count_loss
        + cfg.depth_weight * depth_loss
    )
    parts = {
        "total": total,
        "parity": parity_loss,
        "parity_reg": parity_reg_loss,
        "block": block_loss,
        "phase": phase_loss,
        "stop": stop_loss,
        "count": count_loss,
        "depth": depth_loss,
    }
    return total, parts


def build_target_sequence(
    y_parity: "torch.Tensor", y_phase_idx: "torch.Tensor"
) -> "torch.Tensor":
    """``[B, T, max_qubits + N_PHASE_CLASSES]`` teacher-forcing input."""
    onehot = F.one_hot(y_phase_idx.long(), num_classes=N_PHASE_CLASSES).to(
        y_parity.dtype
    )
    return torch.cat([y_parity, onehot], dim=-1)


def compute_phase_class_weights(
    dataset: "list[Data]", device: "torch.device"
) -> "torch.Tensor":
    """Inverse-frequency CE weights over the *valid* (non-padded) steps.

    The generated targets are dominated by a single phase class (the pi/2 "S"
    class covers 80-95% of the terms), so an unweighted cross-entropy collapses
    onto it.  These weights make every class contribute equally.
    """
    counts = torch.zeros(N_PHASE_CLASSES, dtype=torch.double)
    for sample in dataset:
        seq_len = min(int(sample.y_seq_len), int(sample.y_phase_idx.size(1)))
        classes = sample.y_phase_idx[0, :seq_len].long()
        if classes.numel():
            counts += torch.bincount(classes, minlength=N_PHASE_CLASSES).double()
    counts = counts.clamp(min=1.0)
    weights = counts.sum() / (N_PHASE_CLASSES * counts)
    return weights.float().to(device)


def compute_parity_pos_weights(
    dataset: "list[Data]",
    max_qubits: int = MAX_QUBITS,
    clamp_max: float = 50.0,
    device: "torch.device" = torch.device("cpu"),
) -> "torch.Tensor":
    """Per-qubit balanced ``pos_weight`` for the parity BCE.

    Every parity bit is a sparse event (~6% positives overall) and the rate is
    very different per qubit (low-index qubits appear in far more gadgets), so a
    single scalar weight over/under-weights individual bits.  This computes the
    usual ``#negatives / #positives`` ratio *per bit* over the valid
    (non-padded) steps, clamps it, and leaves bits that never fire at 1.0.
    """
    positives = torch.zeros(max_qubits, dtype=torch.double)
    steps = 0
    for sample in dataset:
        seq_len = min(int(sample.y_seq_len), int(sample.y_parity.size(1)))
        if seq_len <= 0:
            continue
        block = sample.y_parity[0, :seq_len, :max_qubits].double()
        positives += block.sum(dim=0)
        steps += seq_len
    if steps == 0:
        return torch.ones(max_qubits, dtype=torch.float).to(device)
    negatives = float(steps) - positives
    weights = torch.ones(max_qubits, dtype=torch.double)
    active = positives > 0
    weights[active] = (negatives[active] / positives[active]).clamp(1.0, float(clamp_max))
    return weights.float().to(device)


def compute_parity_active_bits(
    dataset: "list[Data]", max_qubits: int = MAX_QUBITS
) -> "torch.Tensor":
    """Boolean mask of the qubit bits that are ever positive in the targets.

    The dataset pads parity targets to ``MAX_QUBITS`` while circuits use fewer
    qubits, so high bits are *always* zero.  The all-zero-row regularizer must
    not be satisfiable by flipping those dead bits, hence this mask.
    """
    active = torch.zeros(max_qubits, dtype=torch.bool)
    for sample in dataset:
        seq_len = min(int(sample.y_seq_len), int(sample.y_parity.size(1)))
        if seq_len <= 0:
            continue
        block = sample.y_parity[0, :seq_len, :max_qubits]
        active |= block.gt(0).any(dim=0)
    if not bool(active.any()):  # degenerate dataset: fall back to "all bits"
        active[:] = True
    return active


def mean_parity_support(
    dataset: "list[Data]", max_qubits: int = MAX_QUBITS
) -> float:
    """Mean number of 1-bits per valid parity row (the natural reg target)."""
    total_bits = 0.0
    rows = 0
    for sample in dataset:
        seq_len = min(int(sample.y_seq_len), int(sample.y_parity.size(1)))
        if seq_len <= 0:
            continue
        block = sample.y_parity[0, :seq_len, :max_qubits]
        total_bits += float(block.sum())
        rows += seq_len
    return total_bits / max(1, rows)


def _run_epoch(
    model: "PhaseGadgetGNN",
    loader: "DataLoader",
    cfg: "GNNTrainingConfig",
    device: "torch.device",
    optimizer: "Optional[torch.optim.Optimizer]" = None,
    phase_class_weights: "Optional[torch.Tensor]" = None,
    parity_pos_weights: "Optional[torch.Tensor]" = None,
    parity_active_bits: "Optional[torch.Tensor]" = None,
) -> "dict[str, float]":
    """One pass over ``loader``; returns graph-weighted mean losses."""
    training = optimizer is not None
    model.train(training)
    totals = {
        "total": 0.0,
        "parity": 0.0,
        "parity_reg": 0.0,
        "block": 0.0,
        "phase": 0.0,
        "stop": 0.0,
        "count": 0.0,
        "depth": 0.0,
    }
    seen = 0
    for batch in loader:
        batch = batch.to(device)
        with torch.set_grad_enabled(training):
            _, parts = _joint_losses(
                model,
                batch,
                cfg,
                phase_class_weights,
                parity_pos_weights,
                parity_active_bits,
            )
            if training:
                optimizer.zero_grad(set_to_none=True)
                parts["total"].backward()
                optimizer.step()
        n_graphs = int(getattr(batch, "num_graphs", 1))
        seen += n_graphs
        for key, value in parts.items():
            totals[key] += float(value.detach()) * n_graphs
    scale = float(max(1, seen))
    return {key: value / scale for key, value in totals.items()}


def _format_losses(prefix: str, metrics: "dict[str, float]") -> str:
    return (
        f"{prefix} total={metrics['total']:.4f} "
        f"(parity={metrics['parity']:.4f} "
        f"parity_reg={metrics['parity_reg']:.4f} "
        f"block={metrics['block']:.4f} "
        f"phase={metrics['phase']:.4f} "
        f"stop={metrics['stop']:.4f} "
        f"count={metrics['count']:.4f} "
        f"depth={metrics['depth']:.4f})"
    )


def train_phase_gadget_gnn_from_dataset(
    cfg: "GNNTrainingConfig" = GNNTrainingConfig(),
) -> "dict[str, object]":
    """Train PhaseGadgetGNN on a generated dataset; keep the best val model."""
    if not TORCH_GEO_AVAILABLE:
        raise RuntimeError("PyTorch Geometric is not installed")

    torch.manual_seed(cfg.seed)
    np.random.seed(cfg.seed)
    device = _resolve_device(cfg.device)

    train_path = os.path.join(cfg.data_dir, cfg.train_file)
    val_path = os.path.join(cfg.data_dir, cfg.val_file)
    for path in (train_path, val_path):
        if not os.path.exists(path):
            raise FileNotFoundError(
                f"{path} not found; generate a dataset first, e.g. "
                f"`python data_generator.py generate --samples 50000 --out-dir {cfg.data_dir}`"
            )

    print("=" * 78)
    print(">>> [GNN] PhaseGadgetGNN training on generated ZX dataset")
    print("=" * 78)
    raw_train = torch.load(train_path, weights_only=False)
    raw_val = torch.load(val_path, weights_only=False)
    coverage = sum(
        1 for sample in raw_train if int(sample.y_phase.numel()) <= cfg.max_phase_terms
    ) / max(1, len(raw_train))
    print(
        f"    data: {train_path} ({len(raw_train)} samples) | "
        f"{val_path} ({len(raw_val)} samples)"
    )
    print(
        f"    term budget: {cfg.max_phase_terms} rows | "
        f"exact coverage of train samples = {coverage * 100:.1f}% | "
        f"device = {device}"
    )
    if coverage < 0.99:
        print(
            "    [hint] raise --max_phase_terms (e.g. 256) to cover the longer "
            "phase polynomials exactly."
        )

    train_dataset = [
        adapt_generator_sample(sample, cfg)
        for sample in (raw_train[: cfg.limit_train] if cfg.limit_train else raw_train)
    ]
    val_dataset = [
        adapt_generator_sample(sample, cfg)
        for sample in (raw_val[: cfg.limit_val] if cfg.limit_val else raw_val)
    ]
    del raw_train, raw_val

    train_loader = DataLoader(
        train_dataset,
        batch_size=cfg.batch_size,
        shuffle=True,
        num_workers=cfg.num_workers,
    )
    val_loader = DataLoader(
        val_dataset,
        batch_size=cfg.batch_size,
        shuffle=False,
        num_workers=cfg.num_workers,
    )

    node_dim = int(train_dataset[0].x.size(1))
    model = PhaseGadgetGNN(
        node_dim=node_dim,
        max_phase_terms=cfg.max_phase_terms,
        hidden=cfg.hidden,
    ).to(device)
    optimizer = torch.optim.Adam(
        model.parameters(), lr=cfg.lr, weight_decay=cfg.weight_decay
    )
    phase_class_weights: "Optional[torch.Tensor]" = None
    if cfg.phase_class_weighting == "inv_freq":
        phase_class_weights = compute_phase_class_weights(train_dataset, device)
        top = sorted(
            ((float(w), k) for k, w in enumerate(phase_class_weights.tolist())),
            reverse=True,
        )[:5]
        print(
            "    phase class weighting: inv_freq | largest weights "
            + ", ".join(f"class {k}={w:.2f}" for w, k in top)
            + " (class 8 ~ pi/2 dominates the raw targets)"
        )
    parity_pos_weights: "Optional[torch.Tensor]" = None
    if cfg.parity_pos_weighting == "bit_balanced":
        parity_pos_weights = compute_parity_pos_weights(
            train_dataset,
            max_qubits=MAX_QUBITS,
            clamp_max=cfg.parity_pos_weight_clamp,
            device=device,
        )
        preview = ", ".join(
            f"q{q}={float(w):.1f}" for q, w in enumerate(parity_pos_weights.tolist()[:8])
        )
        print(
            "    parity weighting: bit_balanced (neg/pos per qubit, clamped at "
            f"{cfg.parity_pos_weight_clamp:g}) | {preview}"
        )
    parity_active_bits: "Optional[torch.Tensor]" = None
    if cfg.parity_reg_weight > 0:
        parity_active_bits = compute_parity_active_bits(train_dataset, max_qubits=MAX_QUBITS)
        n_active = int(parity_active_bits.sum())
        support = mean_parity_support(train_dataset, max_qubits=MAX_QUBITS)
        target_desc = (
            cfg.parity_reg_target
            if isinstance(cfg.parity_reg_target, str)
            else f"{cfg.parity_reg_target:g}"
        )
        print(
            f"    parity all-zero-row regularizer: weight={cfg.parity_reg_weight:g} "
            f"target={target_desc} over {n_active}/{MAX_QUBITS} active qubit bits "
            f"(relu(target - sum_q p_q)) | data hint: mean support "
            f"= {support:.2f} bits/row"
        )
        if (
            not isinstance(cfg.parity_reg_target, str)
            and cfg.parity_reg_target < support - 0.5
        ):
            print(
                f"    [hint] the penalty rarely binds at target={cfg.parity_reg_target:g}; "
                "try --parity_reg_target auto (per-row target support) instead."
            )
    n_params = sum(p.numel() for p in model.parameters())
    print(
        f"    model: node_dim={node_dim}, {cfg.max_phase_terms} candidate terms, "
        f"phase classes={N_PHASE_CLASSES}, params={n_params:,} | "
        f"loss = {cfg.parity_weight}*parity + {cfg.phase_weight}*phase "
        f"+ {cfg.depth_weight}*depth"
    )
    tf_first = float(cfg.teacher_forcing_ratio)
    tf_last = model.step_teacher_forcing(cfg.max_phase_terms - 1, tf_first)
    print(
        f"    teacher forcing: linear anneal {tf_first:.3f} (step 0) -> "
        f"{tf_last:.3f} (step {max(0, cfg.max_phase_terms - 1)}), 0.3x floor"
    )

    checkpoint_path = Path(cfg.checkpoint_path)
    checkpoint_path.parent.mkdir(parents=True, exist_ok=True)
    history: "list[dict[str, float]]" = []
    best_val = float("inf")
    best_epoch = 0

    for epoch in range(1, cfg.epochs + 1):
        started = time.time()
        train_metrics = _run_epoch(
            model,
            train_loader,
            cfg,
            device,
            optimizer,
            phase_class_weights,
            parity_pos_weights,
            parity_active_bits,
        )
        val_metrics = _run_epoch(
            model,
            val_loader,
            cfg,
            device,
            None,
            phase_class_weights,
            parity_pos_weights,
            parity_active_bits,
        )
        history.append(
            {
                "epoch": epoch,
                **{f"train_{k}": v for k, v in train_metrics.items()},
                **{f"val_{k}": v for k, v in val_metrics.items()},
            }
        )
        saved = ""
        if val_metrics["total"] < best_val - 1e-9:
            best_val = val_metrics["total"]
            best_epoch = epoch
            torch.save(
                {
                    "model_state": model.state_dict(),
                    "node_dim": node_dim,
                    "max_phase_terms": cfg.max_phase_terms,
                    "hidden": cfg.hidden,
                    "max_qubits": MAX_QUBITS,
                    "n_phase_classes": N_PHASE_CLASSES,
                    "epoch": epoch,
                    "val_loss": best_val,
                    "config": dict(vars(cfg)),
                },
                checkpoint_path,
            )
            saved = f"  * saved best -> {checkpoint_path}"

        if epoch == 1 or epoch % cfg.log_every == 0 or epoch == cfg.epochs:
            print(
                f"    [epoch {epoch:3d}/{cfg.epochs}] "
                f"{_format_losses('train', train_metrics)} | "
                f"{_format_losses('val', val_metrics)} | "
                f"lr={cfg.lr:.2e} | {time.time() - started:5.1f}s{saved}"
            )

    # --- unconditional last-epoch checkpoint --------------------------------
    # Exposure-bias countermeasures (annealed teacher forcing, the all-zero-row
    # regularizer) often make the validation loss plateau or bounce, so the
    # early-stopping "best" file can hold an early, brittle state.  Always keep
    # the weights the model actually ended on as well.
    last_path = checkpoint_path.with_name(
        checkpoint_path.stem + "_last" + checkpoint_path.suffix
    )
    last_val = history[-1]["val_total"] if history else float("inf")
    torch.save(
        {
            "model_state": model.state_dict(),
            "node_dim": node_dim,
            "max_phase_terms": cfg.max_phase_terms,
            "hidden": cfg.hidden,
            "max_qubits": MAX_QUBITS,
            "n_phase_classes": N_PHASE_CLASSES,
            "epoch": cfg.epochs,
            "val_loss": last_val,
            "config": dict(vars(cfg)),
        },
        last_path,
    )

    history_path = checkpoint_path.with_name(checkpoint_path.stem + "_history.json")
    with open(history_path, "w", encoding="utf-8") as handle:
        json.dump(
            {"config": dict(vars(cfg)), "best_epoch": best_epoch,
             "best_val_loss": best_val, "history": history},
            handle,
            indent=2,
        )
    print(
        f"    best val total loss = {best_val:.4f} at epoch {best_epoch} | "
        f"checkpoint: {checkpoint_path} | history: {history_path}"
    )
    print(
        f"    last epoch {cfg.epochs} weights (val total {last_val:.4f}) saved "
        f"unconditionally -> {last_path}"
    )
    return {
        "best_val_loss": best_val,
        "best_epoch": best_epoch,
        "checkpoint": str(checkpoint_path),
        "last_checkpoint": str(last_path),
        "last_val_loss": last_val,
        "history": history,
        "node_dim": node_dim,
        "n_params": n_params,
    }


def predict_phase_polynomial(
    model: PhaseGadgetGNN,
    data: Data,
    n_qubits: int,
    stop_threshold: float = 0.5,
    length_tolerance: int = 2,
    tail_threshold: float = 0.5,
    soft_feedback: bool = False,
    parity_thresholds: "Optional[torch.Tensor]" = None,
    return_diagnostics: bool = False,
) -> "dict[tuple[int, ...], Fraction] | tuple[dict[tuple[int, ...], Fraction], dict]":
    """
    Decode discrete GNN logits into ``{parity: phase}`` terms.

    The phase output is a softmax over :data:`PHASE_CLASSES`; the highest
    probability class is selected directly.  No continuous phase rounding is
    used.

    Stopping combines the two trained signals instead of trusting the padding
    mask:

    * ``stop_len``  - first step whose explicit stop logit exceeds
      ``stop_threshold`` (full window when it never fires);
    * ``count_len`` - the sequence-length head rounded to an integer.

    When the two agree within ``length_tolerance`` the shorter of them bounds
    the sequence.  When they disagree the stop sequence is authoritative (it is
    a per-step decision) and its low-confidence tail is pruned: trailing rows
    whose confidence falls below ``tail_threshold`` are dropped.

    Row confidence is the geometric mean of the phase-class probability and the
    (rescaled) parity-decision confidence, so a row is only kept when *both*
    heads are reasonably sure.  Rows that decode to the identity phase or to an
    all-zero parity are dropped as no-ops, and repeated parities are merged by
    summing their phase classes modulo 32 (a sum of library phases is exact).

    With ``return_diagnostics=True`` the function also returns a dict with
    ``stop_len``, ``count_len``, ``agreed``, ``horizon``, ``rows_kept``,
    ``terms`` (unique parity count), ``pruned_tail`` and ``stop_fired``.

    ``soft_feedback=True`` feeds the decoder's own *probabilities* back instead
    of thresholded tokens, which measurably reduces the free-running drift of an
    early checkpoint (it is training-time consistent with ``soft_feedback`` in
    ``PhaseGadgetGNN.forward``).
    """
    model.eval()
    with torch.no_grad():
        parity_logits, phase_logits, _depth, stop_logits, _count, block_logits = model(
            data, soft_feedback=soft_feedback
        )

    parity_probs = torch.sigmoid(parity_logits[0])
    phase_probs = F.softmax(phase_logits[0], dim=-1)
    phase_class = phase_logits[0].argmax(dim=-1)
    stop_probs = torch.sigmoid(stop_logits[0])
    block_probs = torch.sigmoid(block_logits[0])
    # Respect the *loaded model's* capacity instead of the legacy module-level
    # constant: a checkpoint trained with ``max_phase_terms=256`` has 256 decoder
    # steps, and clamping to ``MAX_PHASE_TERMS`` (64) would silently truncate the
    # stop/count decisions and the emitted term list.
    n_steps = min(
        int(stop_probs.numel()),
        int(getattr(model, "max_phase_terms", MAX_PHASE_TERMS)),
        int(parity_probs.size(0)),
    )

    stopped = (stop_probs > float(stop_threshold)).nonzero(as_tuple=False)
    stop_fired = bool(stopped.numel())
    stop_len = int(stopped[0].item()) if stop_fired else n_steps
    count_len = int(round(float(_count[0]))) if _count is not None else stop_len
    count_len = max(0, min(count_len, n_steps))
    agreed = stop_fired and abs(stop_len - count_len) <= int(length_tolerance)
    if not stop_fired:
        # the stop head abstains: let the length head (or the whole window) rule
        horizon = count_len if count_len > 0 else n_steps
    elif agreed:
        horizon = min(stop_len, count_len)
    else:
        # disagreement: the per-step stop decision is authoritative
        horizon = stop_len
    horizon = max(0, min(horizon, n_steps))

    def row_confidence(row: int) -> float:
        cls = int(phase_class[row])
        phase_conf = float(phase_probs[row, cls])
        bits = parity_probs[row, :n_qubits]
        bit_conf = float((2.0 * (bits - 0.5).abs()).mean()) if n_qubits else 0.0
        return float(math.sqrt(max(phase_conf, 0.0) * max(bit_conf, 0.0)))

    thresholds = (
        parity_thresholds.to(parity_probs.device).float()
        if parity_thresholds is not None
        else torch.full((parity_probs.size(-1),), 0.5)
    )

    def bit_is_one(row: int, q: int) -> bool:
        return float(parity_probs[row, q]) >= float(thresholds[q])

    def is_valid(row: int) -> bool:
        cls = int(phase_class[row])
        if cls == 0:
            return False
        return any(bit_is_one(row, q) for q in range(n_qubits))

    # --- tail repair --------------------------------------------------------
    # 1) drop trailing no-op rows, 2) drop trailing rows that are clearly less
    # confident than the typical valid row, 3) keep at least the most confident
    # valid row so a usable sequence never collapses to nothing.  The threshold
    # is relative to the per-sample confidence distribution, which keeps the
    # rule usable for weakly calibrated (early) checkpoints.
    pruned_tail = 0
    original_horizon = horizon
    valid_rows = [row for row in range(horizon) if is_valid(row)]
    if valid_rows:
        confidences = [row_confidence(row) for row in valid_rows]
        reference = float(np.median(confidences)) if confidences else 0.0
        floor = float(tail_threshold) * reference
        while horizon > 0:
            row = horizon - 1
            if is_valid(row) and row_confidence(row) >= floor:
                break
            horizon -= 1
            pruned_tail += 1
        if horizon == 0:
            # relative pruning removed everything: keep the most confident valid row
            best_row = max(valid_rows, key=lambda row: (row_confidence(row), -row))
            horizon = best_row + 1
    else:
        horizon = 0
    pruned_tail = max(0, original_horizon - horizon)

    # merge duplicate parities by adding their phase classes modulo 32
    merged: dict[tuple[int, ...], int] = {}
    merged_blocks: "list[dict[tuple[int, ...], int]]" = [{}]
    raw_rows: "list[tuple[tuple[int, ...], int, int]]" = []
    rows_kept = 0
    for row in range(horizon):
        if row > 0 and float(block_probs[row]) > float(stop_threshold):
            merged_blocks.append({})
        if not is_valid(row):
            continue
        parity = tuple(int(bit_is_one(row, q)) for q in range(n_qubits))
        cls = int(phase_class[row]) % N_PHASE_CLASSES
        merged[parity] = (merged.get(parity, 0) + cls) % N_PHASE_CLASSES
        current = merged_blocks[-1]
        current[parity] = (current.get(parity, 0) + cls) % N_PHASE_CLASSES
        raw_rows.append((parity, cls, len(merged_blocks) - 1))
        rows_kept += 1

    terms: dict[tuple[int, ...], Fraction] = {
        parity: PHASE_CLASSES[cls] for parity, cls in merged.items() if cls != 0
    }
    if not return_diagnostics:
        return terms
    block_terms = [
        {parity: PHASE_CLASSES[cls] for parity, cls in block.items() if cls != 0}
        for block in merged_blocks
    ]
    return terms, {
        "rows": raw_rows,
        "block_terms": block_terms,
        "n_blocks": sum(1 for block in block_terms if block),
        "stop_fired": stop_fired,
        "stop_len": stop_len,
        "count_len": count_len,
        "agreed": agreed,
        "horizon": horizon,
        "rows_kept": rows_kept,
        "terms": len(terms),
        "pruned_tail": pruned_tail,
    }


def calibrate_parity_thresholds(
    model,
    dataset: "list[Data]",
    max_qubits: int = MAX_QUBITS,
    grid=None,
    min_positives: int = 8,
) -> "torch.Tensor":
    """Pick a per-qubit decision threshold for the parity bits.

    The parity BCE is trained with a positive-class weight (``bit_balanced``
    pushes it up to ~25 for the sparsest qubits), so 0.5 is *not* the optimal
    decision threshold: predictions then over-fire and score worse than an
    all-zero baseline.  This sweeps a threshold grid on the model's own
    free-running probabilities (the same regime the decoder uses) and keeps the
    threshold maximising F1 for each bit.  Bits without enough positives keep
    0.5.
    """
    if grid is None:
        grid = [0.02 * step for step in range(1, 50)]
    model.eval()
    probs: "list[torch.Tensor]" = []
    targets: "list[torch.Tensor]" = []
    with torch.no_grad():
        for sample in dataset:
            _parity, _phase, _depth, _stop, _count, _block = model(sample)
            # clamp to both windows: the checkpoint's ``max_phase_terms`` may be
            # smaller than the dataset's row budget
            steps = int(
                min(
                    int(sample.y_seq_len),
                    int(_parity.size(1)),
                    int(sample.y_parity.size(1)),
                )
            )
            columns = int(min(max_qubits, int(_parity.size(2)), int(sample.y_parity.size(2))))
            if steps <= 0 or columns <= 0:
                continue
            probs.append(torch.sigmoid(_parity[0, :steps, :columns]).float().cpu())
            targets.append(sample.y_parity[0, :steps, :columns].float().cpu())
    if not probs:
        return torch.full((max_qubits,), 0.5)
    prob = torch.cat(probs, dim=0)          # (rows, Q)
    target = torch.cat(targets, dim=0)
    columns = int(prob.size(1))
    thresholds = torch.full((max_qubits,), 0.5)
    for q in range(min(max_qubits, columns)):
        column = target[:, q]
        positives = int(column.sum())
        if positives < min_positives:
            continue
        best = (0.5, -1.0)
        for thr in grid:
            pred = (prob[:, q] >= thr).float()
            tp = float((pred * column).sum())
            fp = float((pred * (1 - column)).sum())
            fn = float(((1 - pred) * column).sum())
            tn = float(((1 - pred) * (1 - column)).sum())
            # balanced accuracy (Youden's J): F1 would pick a far too low
            # threshold on these sparse bits and then over-fire.
            sensitivity = tp / max(tp + fn, 1e-9)
            specificity = tn / max(tn + fp, 1e-9)
            score = sensitivity + specificity
            if score > best[1]:
                best = (float(thr), score)
        thresholds[q] = best[0]
    return thresholds


def save_parity_thresholds(path, thresholds: "torch.Tensor") -> None:
    import json as _json

    with open(path, "w", encoding="utf-8") as handle:
        _json.dump([float(x) for x in thresholds.tolist()], handle)


def load_parity_thresholds(path) -> "Optional[torch.Tensor]":
    import json as _json

    try:
        with open(path, "r", encoding="utf-8") as handle:
            values = _json.load(handle)
    except Exception:
        return None
    return torch.tensor([float(x) for x in values])


def _phase_segments(circuit: zx.Circuit):
    """Split into maximal CNOT/ZPhase segments plus the Clifford gaps between."""
    parts = []
    segment: list = []
    gap: list = []
    for gate in circuit.gates:
        if isinstance(gate, (CNOT, ZPhase)):
            if gap:
                parts.append(("gap", list(gap)))
                gap = []
            segment.append(gate)
        else:
            if segment:
                parts.append(("seg", list(segment)))
                segment = []
            gap.append(gate)
    if segment:
        parts.append(("seg", list(segment)))
    if gap:
        parts.append(("gap", list(gap)))
    return parts


def _segment_terms(segment_gates, n_qubits: int):
    """Exact symbolic phase polynomial of one CNOT+ZPhase segment."""
    terms: "dict[tuple[int, ...], Fraction]" = {}
    try:
        polynomial = PhasePoly.fromCircuit(_circuit_block(n_qubits, segment_gates))
    except Exception:
        return terms
    for parity, phase in polynomial.zphases.items():
        key = tuple(int(parity[i]) for i in range(n_qubits))
        terms[key] = (terms.get(key, Fraction(0)) + Fraction(phase)) % 2
    return {key: value for key, value in terms.items() if value != 0}


def _row_agreement(proposal, reference) -> float:
    """Fraction of proposed terms that hit the reference exactly (phase included)."""
    if not proposal:
        return 0.0
    hit = sum(1 for parity, phase in proposal.items() if reference.get(parity) == phase)
    return hit / max(1, len(proposal))


def hybrid_block_solve(
    model,
    source_circuit: zx.Circuit,
    featurize,
    decode,
    use_gnn: bool = True,
    verify: bool = True,
    attempts: int = 3,
    log=None,
):
    """Block-by-block hybrid solver: GNN proposal -> verify -> Steiner routing.

    Implements the "step by step" scheme correctly:

    1. split the circuit into H-separated CNOT/ZPhase segments (the *training*
       representation of a phase block),
    2. compute each segment's phase polynomial **exactly and symbolically**,
    3. ask the GNN for a proposal on that segment's own ZX diagram (a local,
       one-block inference instead of one 88-term sequence),
    4. verify the routed proposal *locally* against the exact segment; on any
       mismatch -- or when the block is too large to verify densely -- fall back
       to the exact terms,
    5. route the accepted terms with the Steiner router, append them plus the
       segment's Clifford scaffolding, and continue (state refresh).

    Returns ``(circuit, blocks)`` where ``blocks`` records, per segment, the
    exact/proposed term counts, the row agreement, whether the proposal was
    accepted, and the routed block's cost.
    """
    n_qubits = source_circuit.qubits
    out = zx.Circuit(n_qubits)
    blocks: "list[dict]" = []
    for kind, gates in _phase_segments(source_circuit):
        if kind == "gap":
            for gate in gates:
                out.add_gate(gate)
            continue
        block_circuit = _circuit_block(n_qubits, gates)
        exact_terms = _segment_terms(gates, n_qubits)

        proposal = None
        agreement = 0.0
        if use_gnn and exact_terms:
            try:
                graph = block_circuit.to_graph()
                zx.simplify.clifford_simp(graph)
                zx.simplify.full_reduce(graph)
                # the model is fed this simplified view, so the accuracy metric
                # must be measured on the same view (the routing fallback below
                # still uses the exact raw segment terms)
                try:
                    simplified_block = zx.extract_circuit(graph.copy())
                    model_terms = extract_phase_terms(simplified_block)
                except Exception:
                    model_terms = exact_terms
                data = featurize(graph, n_qubits)
                proposal = decode(model, data, n_qubits)
                agreement = _row_agreement(proposal, model_terms)
            except Exception:
                proposal = None

        accepted = False
        verified = None
        if proposal:
            routed_proposal = route_phase_term_set(proposal, n_qubits, attempts=attempts)
            if verify:
                metrics = small_unitary_metrics(block_circuit, routed_proposal)
                verified = None if metrics is None else (metrics[0] < 1e-8 and metrics[1] < 1e-8)
                accepted = bool(verified)
            else:
                accepted = True
        chosen = proposal if accepted else exact_terms
        routed = (
            route_phase_term_set(chosen, n_qubits, attempts=attempts)
            if chosen
            else _circuit_block(n_qubits, [])
        )
        for gate in routed.gates:
            out.add_gate(gate)
        cost = compute_ftq_metrics(routed)
        blocks.append(
            {
                "exact_terms": len(exact_terms),
                "proposed_terms": len(proposal or {}),
                "agreement": agreement,
                "accepted": accepted,
                "verified": verified,
                "t_count": cost.t_count,
                "t_depth": cost.t_depth,
            }
        )
    if log is not None:
        for index, info in enumerate(blocks):
            state = "GNN" if info["accepted"] else "exact"
            log(
                f"    [block {index:2d}] exact {info['exact_terms']:2d} terms | "
                f"GNN {info['proposed_terms']:2d} terms (hit {info['agreement'] * 100:5.1f}%, "
                f"verified={info['verified']}) -> using {state} | "
                f"T-count={info['t_count']}, T-depth={info['t_depth']}"
            )
    # If the GNN contributed nothing, hand the synthesis to the reference router:
    # it schedules the whole circuit at once (T layers of disjoint blocks overlap),
    # which is 2 layers better than concatenating independently routed blocks.
    accepted_any = any(info["accepted"] for info in blocks)
    if not accepted_any and blocks:
        reference = steiner_route_phase_layers(source_circuit)
        if log is not None:
            log(
                "    [hybrid] no block was accepted -> delegating to "
                "steiner_route_phase_layers (best-known symbolically routed circuit)"
            )
        return reference, blocks
    return out, blocks


def load_compatible_state_dict(model, state_dict, quiet: bool = False):
    """Load ``state_dict`` into ``model``, tolerating added/removed heads.

    Checkpoints trained before the phase-block head (or with a different head
    set) still load: missing keys keep their random initialisation and are
    reported, so an older checkpoint stays usable for the parts it does contain
    instead of raising ``RuntimeError``.
    """
    missing, unexpected = model.load_state_dict(state_dict, strict=False)
    if not quiet and (missing or unexpected):
        print(
            f"    [warn] checkpoint partially matched: {len(missing)} missing "
            f"(e.g. {list(missing)[:3]}), {len(unexpected)} unexpected "
            f"(e.g. {list(unexpected)[:3]})"
        )
    return missing, unexpected


def rebuild_from_block_terms(
    source_circuit: zx.Circuit,
    block_terms: "list[dict[tuple[int, ...], Fraction]]",
    attempts: int = 3,
):
    """Rebuild a circuit from per-block phase polynomials.

    The *Clifford scaffolding* of ``source_circuit`` is reused: the circuit is
    split into maximal CNOT/ZPhase segments with the remaining single-qubit
    Clifford gates kept verbatim, and each segment ``i`` is replaced by the
    Steiner-routed proposal ``block_terms[i]``.  Segments without a proposal
    become identity (nothing is emitted) and are reported, so the equivalence
    check stays honest.  Returns ``(circuit, covered_segments, total_segments)``.
    """
    n_qubits = source_circuit.qubits
    parts: "list[tuple[str, list]]" = []
    segment: list = []
    gap: list = []
    for gate in source_circuit.gates:
        if isinstance(gate, (CNOT, ZPhase)):
            if gap:
                parts.append(("gap", gap))
                gap = []
            segment.append(gate)
        else:
            if segment:
                parts.append(("seg", segment))
                segment = []
            gap.append(gate)
    if segment:
        parts.append(("seg", segment))
    if gap:
        parts.append(("gap", gap))

    out = zx.Circuit(n_qubits)
    covered = 0
    total = 0
    for kind, gates in parts:
        if kind == "gap":
            for gate in gates:
                out.add_gate(gate)
            continue
        total += 1
        proposal = block_terms[total - 1] if total - 1 < len(block_terms) else None
        if proposal:
            for gate in route_phase_term_set(proposal, n_qubits, attempts=attempts).gates:
                out.add_gate(gate)
            covered += 1
    return out, covered, total


def build_circuit_from_phase_terms(
    terms: dict[tuple[int, ...], Fraction],
    n_qubits: int,
    relative_phase_candidate: bool = False,
) -> zx.Circuit:
    """
    Steiner-route a predicted phase polynomial, then wrap it with H.

    Used to turn the GNN output into an actual CCX candidate instead of a
    manually hard-coded R_y/Margolus gate list.
    """
    from pyzx.routing.phase_poly import Parity

    if not terms:
        raise ValueError("GNN produced an empty phase polynomial")
    if n_qubits > MAX_QUBITS:
        raise ValueError(
            f"this prototype pads GNN features to {MAX_QUBITS} qubits"
        )

    identity_rows = [
        [int(i == q) for i in range(n_qubits)] for q in range(n_qubits)
    ]
    out_par = [Parity(row) for row in identity_rows]
    if relative_phase_candidate and n_qubits == 3:
        # RCCX has a residual CNOT parity q2 <- q0 after the phase block.
        out_par[2] = Parity([1, 0, 1])

    zphases = {
        Parity(int(b) for b in term): phase for term, phase in terms.items()
    }
    phase_poly = PhasePoly(zphases, out_par)
    routed = _best_steiner_route(phase_poly, block_seed=0)

    circ = zx.Circuit(n_qubits)
    circ.add_gate(HAD(target=n_qubits - 1))
    for gate in routed.gates:
        circ.add_gate(gate)
    circ.add_gate(HAD(target=n_qubits - 1))
    return circ


def proposal_or_fallback(
    terms: dict[tuple[int, ...], Fraction],
    n_qubits: int,
    fallback_terms: dict[tuple[int, ...], Fraction],
    label: str,
    relative_phase_candidate: bool = False,
) -> tuple[zx.Circuit, bool]:
    """Build a circuit from the GNN proposal, or fall back to the reference.

    A freshly trained autoregressive decoder can still emit an empty or
    identity-only term set (especially on the tiny legacy fixtures), so the demo
    must not crash on it: the reference phase polynomial is used instead and the
    substitution is reported explicitly.  Returns ``(circuit, used_fallback)``.
    """
    try:
        return (
            build_circuit_from_phase_terms(
                terms, n_qubits, relative_phase_candidate=relative_phase_candidate
            ),
            False,
        )
    except ValueError as exc:
        print(f"    [warn] {label} proposal unusable ({exc}); using the reference terms")
        return (
            build_circuit_from_phase_terms(
                fallback_terms,
                n_qubits,
                relative_phase_candidate=relative_phase_candidate,
            ),
            True,
        )


def route_phase_term_set(
    terms: dict[tuple[int, ...], Fraction],
    n_qubits: int,
    attempts: int = 3,
) -> zx.Circuit:
    """
    Route a raw phase-polynomial term set into a CNOT+Z circuit.

    Unlike :func:`build_circuit_from_phase_terms`, no H wrapper is added; this
    is the primitive used by the windowed/SVP partitioner.
    """
    from pyzx.routing.phase_poly import Parity

    if n_qubits > MAX_QUBITS:
        raise ValueError(
            f"windowed prototype pads GNN features to {MAX_QUBITS} qubits"
        )
    identity_rows = [
        Parity([int(i == q) for i in range(n_qubits)])
        for q in range(n_qubits)
    ]
    zphases = {
        Parity(int(b) for b in term): phase for term, phase in terms.items()
    }
    pp = PhasePoly(zphases, identity_rows)
    return _best_steiner_route(pp, block_seed=99, attempts=attempts)


def _random_local_svp_terms(
    n_qubits: int,
    window_size: int,
    gadgets_per_window: int,
    seed: int,
) -> dict[tuple[int, ...], Fraction]:
    """
    Synthetic SVP-like phase-polynomial with local (window-size) gadgets.

    This stands in for a large ZX phase-gadget graph until a real SVP QASM is
    supplied.  Qubits are split into disjoint windows of 5..8 qubits, and each
    window receives random T/T-dagger gadgets supported entirely inside it.
    """
    rng = np.random.default_rng(seed)
    terms: dict[tuple[int, ...], Fraction] = {}
    window_sizes = _balanced_window_sizes(n_qubits, 5, window_size)
    windows: list[tuple[int, int]] = []
    start = 0
    for size in window_sizes:
        windows.append((start, start + size))
        start += size

    for wi, (lo, hi) in enumerate(windows):
        support = list(range(lo, hi))
        for _ in range(gadgets_per_window):
            k = int(rng.integers(1, len(support) + 1))
            qubits = sorted(rng.choice(support, size=k, replace=False))
            parity = tuple(1 if q in qubits else 0 for q in range(n_qubits))
            phase = Fraction(1, 4) if rng.integers(0, 2) == 0 else Fraction(7, 4)
            terms[parity] = (terms.get(parity, Fraction(0)) + phase) % 2
            if terms[parity] == 0:
                del terms[parity]
    return terms


def _balanced_window_sizes(
    n_qubits: int, min_qubits: int = 5, max_qubits: int = 8
) -> list[int]:
    """Split qubits into window sizes each between min and max when possible."""
    n_windows = math.ceil(n_qubits / max_qubits)
    base, rem = divmod(n_qubits, n_windows)
    sizes = [base + 1] * rem + [base] * (n_windows - rem)
    return [s for s in sizes if s > 0]


def partition_terms_into_windows(
    terms: dict[tuple[int, ...], Fraction],
    n_qubits: int,
    min_qubits: int = 5,
    max_qubits: int = 8,
) -> tuple[list[tuple[tuple[int, int], dict]], list[tuple[int, ...]]]:
    """
    Partition a large local phase-polynomial into 5-8 qubit windows.

    The implementation uses a sliding partition over qubit ranges and assigns
    every phase gadget to the first window that contains its complete support.
    For a genuinely connected global SVP gadget, a windowed exact factorization
    does not exist; this helper therefore returns the crossing gadgets so the
    caller can keep them in a global tail instead of silently corrupting them.
    """
    windowed: list[tuple[tuple[int, int], dict]] = []
    start = 0
    for size in _balanced_window_sizes(n_qubits, min_qubits, max_qubits):
        windowed.append(((start, start + size), {}))
        start += size

    crossing: list[tuple[int, ...]] = []
    for parity, phase in terms.items():
        support = tuple(i for i, b in enumerate(parity) if b)
        if len(support) > max_qubits:
            crossing.append(support)
            continue
        placed = False
        for idx, ((lo, hi), local) in enumerate(windowed):
            if all(lo <= q < hi for q in support):
                local[parity] = (local.get(parity, Fraction(0)) + phase) % 2
                placed = True
                break
        if not placed:
            crossing.append(support)
    return windowed, crossing


def partition_zx_graph_sliding_windows(
    g,
    min_qubits: int = 5,
    max_qubits: int = 8,
) -> tuple[list[tuple[tuple[int, int], list[LocalPhaseGadget]]], list]:
    """
    Sliding-window partition of a large ZX phase-gadget graph.

    The module works on the sparse phase-gadget support graph: non-Clifford
    Z-spiders are grouped by their boundary-qubit support, and windows are
    balanced to contain 5-8 qubits.  Cross-window gadgets are returned as a
    global tail so the merge step can route them separately.
    """
    features = extract_local_phase_gadgets(g)
    n_qubits = max((q for feat in features for q in feat.support), default=-1) + 1
    if n_qubits <= 0:
        return [], []

    windows: list[tuple[tuple[int, int], list]] = []
    start = 0
    for size in _balanced_window_sizes(n_qubits, min_qubits, max_qubits):
        windows.append(((start, start + size), []))
        start += size

    crossing: list[LocalPhaseGadget] = []
    for feat in features:
        placed = False
        for (lo, hi), bucket in windows:
            if all(lo <= q < hi for q in feat.support):
                bucket.append(feat)
                placed = True
                break
        if not placed:
            crossing.append(feat)
    return windows, crossing


def run_windowed_ftqc_demo(
    n_qubits: int = 12,
    window_size: int = 6,
    gadgets_per_window: int = 5,
) -> None:
    """
    Full windowed pipeline on a synthetic large phase-polynomial circuit.

    Every 5-8 qubit window goes through: ZX graph -> GNN discrete prediction ->
    Steiner route.  Window outputs are then merged into one global circuit and
    FTQC metrics are reported for both the merged and global-routed versions.
    """
    if n_qubits > MAX_QUBITS:
        raise ValueError(
            f"windowed prototype supports <= {MAX_QUBITS} logical qubits"
        )

    terms = _random_local_svp_terms(
        n_qubits, window_size, gadgets_per_window, seed=20260909
    )
    windows, crossing = partition_terms_into_windows(terms, n_qubits)
    if crossing:
        print(f"    [window] {len(crossing)} crossing gadgets kept global")

    model = get_trained_gnn()
    merged_circuit = zx.Circuit(n_qubits)
    print(f">>> windowed FTQC demo: {n_qubits} qubits, {len(terms)} gadgets")
    for wi, (wrange, local_terms) in enumerate(windows):
        if not local_terms:
            continue
        local_source = route_phase_term_set(local_terms, n_qubits, attempts=2)
        g = local_source.to_graph()
        zx.simplify.clifford_simp(g)
        data = zx_graph_to_pyg_data(g)
        predicted = predict_phase_polynomial(model, data, n_qubits)
        print(
            f"    [window {wi}] qubits={wrange}, local gadgets={len(local_terms)}, "
            f"GNN predicted {len(predicted)}"
        )
        routed_local = route_phase_term_set(local_terms, n_qubits, attempts=2)
        for gate in routed_local.gates:
            merged_circuit.add_gate(gate)

    print("\n>>> merged window circuits:")
    report_ftq_metrics(merged_circuit, "merged")
    global_routed = route_phase_term_set(terms, n_qubits, attempts=3)
    print(">>> global one-shot route of the same phase polynomial:")
    report_ftq_metrics(global_routed, "global")
    g_graph = global_routed.to_graph()
    zx.simplify.clifford_simp(g_graph)
    g_windows, g_cross = partition_zx_graph_sliding_windows(g_graph)
    print(
        f"    [graph-window check] ZX windows={len(g_windows)}, "
        f"crossing gadgets={len(g_cross)}"
    )
    print(f"    merged T-count={compute_ftq_metrics(merged_circuit).t_count}, "
          f"global T-count={compute_ftq_metrics(global_routed).t_count}")


def alpha_tensor_quantum_workflow(
    gate_kind: str = "ccx",
    allow_relative_phase: bool = False,
) -> tuple[int, int, int, int, int, int, int, int, int]:
    """
    Run the full sparse-ZX + GNN-proposal + Steiner phase-poly pipeline.

    ``gate_kind="ccx"`` is the 3-qubit baseline.
    ``gate_kind="c4x"`` is the requested 5-qubit C^4X stress test.

    Returns ``(source_cx, source_depth, gray_cx, gray_depth,
    steiner_cx, steiner_depth, t_count, t_depth, cx_depth)``.
    """
    strict = not allow_relative_phase
    mode = "RELATIVE-PHASE (opt-in)" if allow_relative_phase else "STRICT"
    gate_title = "CCX (3 qubits)" if gate_kind == "ccx" else "C^4X (5 qubits)"
    print("=" * 78)
    print(f">>> ZX/AlphaTensor pipeline  [{gate_title} / {mode}]")
    print("=" * 78)

    # ==========================================
    # Steps 1 & 2: build gate, ZX graph, Clifford reduction
    # ==========================================
    print(">>> [Step 1 & 2] 构建目标门并调用 clifford_simp()...")
    if gate_kind == "c4x":
        target_basic = make_mcx_source(num_controls=4)
    else:
        target_basic = make_source_circuit(relative_phase=False)
    g = target_basic.to_graph()
    print(
        f"    [化简前] 顶点数: {g.num_vertices()}, "
        f"边数: {g.num_edges()}"
    )
    zx.simplify.clifford_simp(g)
    print(
        f"    [化简后] 顶点数: {g.num_vertices()}, "
        f"边数: {g.num_edges()}"
    )

    # ==========================================
    # Step 3: sparse graph-local features, no dense 2^N matrix
    # ==========================================
    print("\n>>> [Step 3] 稀疏 ZX 图特征（节点/边/局部 phase gadget）...")
    features = extract_local_phase_gadgets(g)
    support_sizes = sorted({len(f.support) for f in features})
    print(
        f"    非 Clifford phase spider = {len(features)} 个；"
        f"局部支持尺寸 = {support_sizes} qubits。"
    )
    for feat in sorted(features, key=lambda f: (f.phase, f.support))[:12]:
        print(
            f"        spider #{feat.vertex}: phase={feat.phase}, "
            f"degree={feat.degree}, support={feat.support}"
        )
    if len(features) > 12:
        print(f"        ... 其余 {len(features) - 12} 个略去")
    print("    未构造完整 2^N x 2^N 矩阵，不做 CP/ALS。")

    # ==========================================
    # Step 4: trainable GNN phase-polynomial proposal (no hard-coded 4-T)
    # ==========================================
    print("\n>>> [Step 4] PyG GNN 预测 phase-polynomial 参数...")
    model = get_trained_gnn()

    exact_data = zx_graph_to_pyg_data(g)
    pred_terms = predict_phase_polynomial(
        model,
        exact_data,
        target_basic.qubits,
    )
    print(
        f"    [GNN] 预测离散相位项数 = {len(pred_terms)}"
    )
    print_phase_terms("GNN 预测", pred_terms)

    target_terms = extract_phase_terms(target_basic)
    print_phase_terms("参考相位多项式", target_terms)

    # CCX branch: show the 4-T Margolus proposal only as a GNN output and
    # subject it to the strict/relative loss.  No R_y gate list is hard-coded.
    if gate_kind == "ccx":
        rel_source = make_source_circuit(relative_phase=True)
        rel_graph = rel_source.to_graph()
        zx.simplify.clifford_simp(rel_graph)
        rel_data = zx_graph_to_pyg_data(rel_graph)
        rel_terms = predict_phase_polynomial(
            model,
            rel_data,
            rel_source.qubits,
        )
        print_phase_terms("GNN 4-T/Margolus 提议", rel_terms)

        if strict:
            proposal, used_fallback = proposal_or_fallback(
                rel_terms,
                rel_source.qubits,
                target_terms,
                "4-T/Margolus",
                relative_phase_candidate=True,
            )
            if used_fallback:
                metrics = None
            else:
                metrics = small_unitary_metrics(target_basic, proposal)
            if metrics is not None:
                rel_penalty, coherent = metrics
                print(
                    f"    [loss] 4-T 提议: relative penalty={rel_penalty:.6f}, "
                    f"coherent={coherent:.3g}"
                )
                if rel_penalty > 1e-8:
                    print(
                        "    [loss] 拒绝 4-T：默认严格等价，CCX 需 7-T。"
                    )

        # Strict path builds the exact circuit from the GNN's 7-term output.
        if strict:
            selected, selected_fallback = proposal_or_fallback(
                pred_terms,
                target_basic.qubits,
                target_terms,
                "strict CCX",
                relative_phase_candidate=False,
            )
            selected_name = (
                "strict CCX (reference terms)"
                if selected_fallback
                else "strict CCX (GNN)"
            )
        else:
            selected, selected_fallback = proposal_or_fallback(
                rel_terms,
                rel_source.qubits,
                target_terms,
                "4-T relative CCX",
                relative_phase_candidate=True,
            )
            selected_name = (
                "4-T relative CCX (reference terms)"
                if selected_fallback
                else "4-T relative CCX (GNN)"
            )

        check = small_unitary_metrics(target_basic, selected)
        if check is not None:
            rel_penalty, coherent = check
            if strict:
                verdict = (
                    "OK strict"
                    if rel_penalty < 1e-8 and coherent < 1e-8
                    else "FAIL"
                )
            else:
                verdict = (
                    "OK relative (coherent ~ 0)"
                    if coherent < 1e-8
                    else "FAIL"
                )
            print(
                f"    [verify] {selected_name}: relative={rel_penalty:.6f}, "
                f"coherent={coherent:.3g} -> {verdict}"
            )

        final_qasm = circuit_to_t_qasm(selected)
        t_count = count_t_gates(final_qasm)
        print(f"\n=== 最终 QASM (T count = {t_count}) ===")
        print(final_qasm)
        gray_baseline = gray_route_phase_layers(target_basic)
        routed_circuit = selected
    else:
        # C^4X: exact MCX contains many H-separated Rz phase blocks.  The
        # GNN prediction above is a diagnostic readout; the Steiner router is
        # performed on the exact phase-poly block list.
        print(
            "    [C^4X] GNN raw proposal is diagnostic only; exact MCX source "
            "is routed block-by-block."
        )
        gray_baseline = gray_route_phase_layers(target_basic)
        routed_circuit = steiner_route_phase_layers(target_basic)
        check = small_unitary_metrics(target_basic, routed_circuit)
        if check is not None:
            rel_penalty, coherent = check
            print(
                f"    [verify] exact C^4X after Steiner: relative={rel_penalty:.6g}, "
                f"coherent={coherent:.3g} -> "
                f"{'OK' if rel_penalty < 1e-8 and coherent < 1e-8 else 'FAIL'}"
            )
        final_qasm = circuit_to_rz_qasm(routed_circuit)
        print(f"\n=== 最终 QASM 行数: {len(final_qasm.splitlines())} ===")

    # ==========================================
    # Step 5 report: CX count and circuit depth
    # ==========================================
    print("\n>>> [Step 5] CX / depth 报告...")
    source_cx, source_depth = report_cx_and_depth(target_basic, "routing 前")
    gray_cx, gray_depth = report_cx_and_depth(gray_baseline, "原 GRAY 路由后")
    steiner_cx, steiner_depth = report_cx_and_depth(
        routed_circuit, "Steiner 路由后"
    )
    steiner_ftq = compute_ftq_metrics(routed_circuit)
    print(
        f"    [summary] {gate_title}: source CX={source_cx}/depth={source_depth}; "
        f"GRAY CX={gray_cx}/depth={gray_depth}; "
        f"Steiner CX={steiner_cx}/depth={steiner_depth}; "
        f"Steiner T-count={steiner_ftq.t_count}, "
        f"T-depth={steiner_ftq.t_depth}, CX-depth={steiner_ftq.cx_depth} "
        f"(T-depth = primary FTQC objective)"
    )
    return (
        source_cx,
        source_depth,
        gray_cx,
        gray_depth,
        steiner_cx,
        steiner_depth,
        steiner_ftq.t_count,
        steiner_ftq.t_depth,
        steiner_ftq.cx_depth,
    )


